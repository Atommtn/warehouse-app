@using WarehouseApp.Services
@using WarehouseApp.Models
@inject PriceAnalysisService PriceService
@inject AuthService Auth
@inject WarehouseService Warehouse

<div class="page-header">
    <h2>📈 تحلیل قیمت مواد اولیه</h2>
    <button class="btn btn-secondary" @onclick="Load">🔄 بروزرسانی</button>
</div>

@if (!loaded)
{
    <div class="loading">در حال محاسبه...</div>
}
else
{
    <!-- کارت خلاصه -->
    @if (Auth.IsAdmin)
    {
        <div class="stats-grid">
            <div class="stat-card green">
                <div class="stat-icon">💰</div>
                <div class="stat-info">
                    <div class="stat-value">@totalValue.ToString("N0") ﷼</div>
                    <div class="stat-label">ارزش کل انبار (میانگین موزون)</div>
                </div>
            </div>
            <div class="stat-card red">
                <div class="stat-icon">📈</div>
                <div class="stat-info">
                    <div class="stat-value">@analyses.Count(a => a.Trend == PriceTrend.Up)</div>
                    <div class="stat-label">ماده با قیمت صعودی</div>
                </div>
            </div>
            <div class="stat-card blue">
                <div class="stat-icon">📉</div>
                <div class="stat-info">
                    <div class="stat-value">@analyses.Count(a => a.Trend == PriceTrend.Down)</div>
                    <div class="stat-label">ماده با قیمت نزولی</div>
                </div>
            </div>
        </div>
    }

    <div class="form-card price-chart-card"><h3>نمودار تغییر قیمت کالای انتخابی</h3><div class="form-grid">
      <div class="form-group"><label>ماده</label><select class="form-input" @bind="chartMaterialId"><option value="0">انتخاب کنید...</option>@foreach(var a in analyses.OrderBy(x=>x.MaterialCode)){<option value="@a.MaterialId">[@a.MaterialCode] @a.MaterialName</option>}</select></div>
      <div class="form-group"><label>از تاریخ</label><PersianDatePicker Value="chartFrom" ValueChanged="@(x=>chartFrom=x)" /></div><div class="form-group"><label>تا تاریخ</label><PersianDatePicker Value="chartTo" ValueChanged="@(x=>chartTo=x)" /></div>
    </div><button class="btn btn-primary" @onclick="ApplyChart">نمایش نمودار</button>
    @if(chartPoints.Any()){
      <div class="chart-summary"><span>اولین فی: <strong>@chartPoints.First().Price.ToString("N0")</strong></span><span>آخرین فی: <strong>@chartPoints.Last().Price.ToString("N0")</strong></span><span class="@(ChartChange>=0?"price-up":"price-down")">تغییر: @ChartChange.ToString("N1")%</span></div>
      <div class="price-svg-wrap"><svg viewBox="0 0 900 300" class="price-svg"><line x1="50" y1="20" x2="50" y2="260" class="chart-axis"/><line x1="50" y1="260" x2="880" y2="260" class="chart-axis"/><polyline points="@SvgPoints" class="chart-line" fill="none"/>@for(var i=0;i<chartPoints.Count;i++){var p=SvgPoint(i,chartPoints[i].Price);<circle cx="@p.x" cy="@p.y" r="5" class="chart-dot"><title>@chartPoints[i].EntryDate.ToShamsi() — @chartPoints[i].Price.ToString("N0") ریال</title></circle>}</svg></div>
    } else if(chartMaterialId>0){<div class="empty-state">در این بازه خریدی ثبت نشده است.</div>}
    </div>

    <!-- جدول اصلی -->
    <div class="search-bar"><input class="form-input search-input" @bind="search" @bind:event="oninput" placeholder="🔍 جستجو بر اساس نام یا کد کالا..." /></div>
    <div class="table-responsive" style="margin-top:1rem">
        <table class="data-table">
            <thead>
                <tr>
                    <th>کد</th>
                    <th>نام ماده</th>
                    <th>موجودی</th>
                    @if (Auth.CanViewPrice)
                    {
                        <th>آخرین خرید</th>
                        <th>خرید قبلی</th>
                        <th>میانگین موزون</th>
                        <th>تغییر قیمت</th>
                        <th>ارزش موجودی</th>
                    }
                    <th>روند</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in FilteredAnalyses)
                {
                    <tr>
                        <td><code>@a.MaterialCode</code></td>
                        <td><strong>@a.MaterialName</strong></td>
                        <td>@a.CurrentStock.ToString("N2") @a.Unit</td>
                        @if (Auth.CanViewPrice)
                        {
                            <td>@a.LastPrice.ToString("N0") ﷼</td>
                            <td>
                                @if (a.History.Count >= 2)
                                { @a.History[^2].Price.ToString("N0") <text> ﷼</text> }
                                else { <span class="text-muted">-</span> }
                            </td>
                            <td><strong>@a.WeightedAvgPrice.ToString("N0") ﷼</strong></td>
                            <td>
                                @if (a.Trend == PriceTrend.NoData)
                                {
                                    <span class="text-muted">بدون داده</span>
                                }
                                else if (a.Trend == PriceTrend.Stable)
                                {
                                    <span class="price-stable">← بدون تغییر</span>
                                }
                                else
                                {
                                    <span class="@(a.Trend == PriceTrend.Up ? "price-up" : "price-down")">
                                        @(a.Trend == PriceTrend.Up ? "↑" : "↓")
                                        @Math.Abs(a.PriceChangePercent)%
                                        (@(a.PriceChange > 0 ? "+" : "")@a.PriceChange.ToString("N0") ﷼)
                                    </span>
                                }
                            </td>
                            <td>@a.StockValue.ToString("N0") ﷼</td>
                        }
                        <td>
                            @if (a.Trend == PriceTrend.Up)    { <span class="trend-badge up">↑ گران‌تر</span> }
                            else if (a.Trend == PriceTrend.Down)  { <span class="trend-badge down">↓ ارزان‌تر</span> }
                            else if (a.Trend == PriceTrend.Stable){ <span class="trend-badge stable">← ثابت</span> }
                            else                                   { <span class="trend-badge nodata">بدون خرید</span> }
                        </td>
                        <td>
                            <button class="btn-icon" @onclick="()=>ToggleDetail(a.MaterialId)" title="تاریخچه">
                                @(expandedId == a.MaterialId ? "▲" : "▼")
                            </button>
                        </td>
                    </tr>

                    @if (expandedId == a.MaterialId && a.History.Any())
                    {
                        <tr class="detail-row">
                            <td colspan="@(Auth.CanViewPrice ? 9 : 4)">
                                <div class="price-history">
                                    <div class="price-history-title">📊 تاریخچه خریدهای [@a.MaterialCode] @a.MaterialName</div>
                                    <table class="history-table">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>تاریخ ورود</th>
                                                <th>مقدار</th>
                                                @if (Auth.CanViewPrice)
                                                {
                                                    <th>قیمت خرید</th>
                                                    <th>میانگین تجمعی</th>
                                                <th>تغییر</th><th>اصلاح</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < a.History.Count; i++)
                                            {
                                                var h = a.History[i];
                                                var idx = i;
                                                <tr>
                                                    <td>@(i + 1)</td>
                                                    <td>@h.EntryDate.ToShamsi()</td>
                                                    <td>@h.Quantity.ToString("N2") @a.Unit</td>
                                                    @if (Auth.CanViewPrice)
                                                    {
                                                        <td>@h.Price.ToString("N0") ﷼</td>
                                                        <td><strong>@h.CumulativeAvg.ToString("N0") ﷼</strong></td>
                                                        <td>
                                                            @if (idx == 0)
                                                            {
                                                                <span class="text-muted">اولین خرید</span>
                                                            }
                                                            else
                                                            {
                                                                var prev = a.History[idx - 1].Price;
                                                                var diff = h.Price - prev;
                                                                var pct  = prev > 0 ? Math.Round(diff / prev * 100, 1) : 0;
                                                                <span class="@(diff > 0 ? "price-up" : diff < 0 ? "price-down" : "price-stable")">
                                                                    @(diff > 0 ? "↑" : diff < 0 ? "↓" : "←")
                                                                    @Math.Abs(pct)%
                                                                </span>
                                                            }
                                                        </td>
                                                        <td>@if(editPriceEntryId==h.EntryId){<div class="inline-form"><input type="number" class="form-input" @bind="editPrice"/><button class="btn btn-primary btn-sm" @onclick="()=>SavePrice(h.EntryId)">ذخیره</button></div>}else{<button class="btn-icon" @onclick="()=>StartPriceEdit(h)">✏️</button>}</td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    bool loaded;
    List<PriceAnalysis> analyses = new();
    decimal totalValue;
    int? expandedId;
    string search="";
    int chartMaterialId;DateTime chartFrom=DateTime.Today.AddYears(-1),chartTo=DateTime.Today;List<PriceHistory> chartPoints=new();int? editPriceEntryId;decimal editPrice;
    decimal ChartChange=>chartPoints.Count<2||chartPoints.First().Price==0?0:(chartPoints.Last().Price-chartPoints.First().Price)/chartPoints.First().Price*100;
    string SvgPoints=>string.Join(" ",chartPoints.Select((x,i)=>{var p=SvgPoint(i,x.Price);return $"{p.x:F1},{p.y:F1}";}));
    (double x,double y) SvgPoint(int i,decimal price){var min=chartPoints.Min(x=>x.Price);var max=chartPoints.Max(x=>x.Price);var x=chartPoints.Count==1?465:50+i*(830d/(chartPoints.Count-1));var y=max==min?140:260-(double)((price-min)/(max-min))*220;return(x,y);}
    IEnumerable<PriceAnalysis> FilteredAnalyses=>string.IsNullOrWhiteSpace(search)?analyses:analyses.Where(x=>x.MaterialName.Contains(search,StringComparison.OrdinalIgnoreCase)||x.MaterialCode.Contains(search,StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await Load();

    async Task Load()
    {
        loaded = false;
        analyses = await PriceService.GetAllAnalysisAsync();
        if (Auth.IsAdmin)
            totalValue = analyses.Sum(a => a.StockValue);
        loaded = true;
    }
    void ApplyChart(){var a=analyses.FirstOrDefault(x=>x.MaterialId==chartMaterialId);chartPoints=a?.History.Where(x=>x.EntryDate.Date>=chartFrom.Date&&x.EntryDate.Date<=chartTo.Date).OrderBy(x=>x.EntryDate).ToList()??new();}
    void StartPriceEdit(PriceHistory h){editPriceEntryId=h.EntryId;editPrice=h.Price;}
    async Task SavePrice(int id){await Warehouse.CorrectEntryPriceAsync(id,editPrice,Auth.CurrentUser!.Username);editPriceEntryId=null;await Load();ApplyChart();}

    void ToggleDetail(int id) => expandedId = expandedId == id ? null : id;
}
