@using WarehouseApp.Services
@using WarehouseApp.Models
@inject WarehouseService Warehouse
@inject AuthService Auth
@inject SmsService Sms

<div class="page-header">
    <h2>🔔 هشدارهای انبار</h2>
    <button class="btn btn-secondary" @onclick="Reload">🔄</button>
</div>

@if (Auth.IsAdmin)
{
    <div class="form-card">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.5rem">
            <h3>📱 پیامک هشدار</h3>
            @if (Sms.IsConfigured) { <span class="status-badge ok">پنل آسانک وصل است — خط @Sms.Source</span> }
            else { <span class="status-badge danger">پنل پیامک تنظیم نشده (SMS_USERNAME / SMS_PASSWORD / API_CODE / SMS_SOURCE در فایل .env)</span> }
        </div>
        @if (smsSettings != null)
        {
            <div class="form-grid">
                <div class="form-group"><label>شماره‌های گیرنده</label><input class="form-input" @bind="recipientsText" placeholder="09121234567, 09351234567" /><small class="form-hint">با ویرگول جدا کنید</small></div>
                <div class="form-group"><label>خلاصه‌ی روزانه</label><label class="permission-item"><input type="checkbox" @bind="smsSettings.DailyEnabled" /><span>هر روز ساعت</span></label><select class="form-input" @bind="smsSettings.DailyHour">@for (var h = 0; h < 24; h++) {<option value="@h">@h:00</option>}</select></div>
                <div class="form-group"><label>پیامک فوری</label><label class="permission-item"><input type="checkbox" @bind="smsSettings.InstantEnabled" /><span>وقتی موجودی کالایی به حد هشدار رسید</span></label></div>
                <div class="form-group" style="grid-column:1/-1"><label>متن پیامک</label><textarea class="form-input" rows="2" @bind="smsSettings.Text"></textarea><small class="form-hint">همین متن برای خلاصه‌ی روزانه و پیامک فوری فرستاده می‌شود</small></div>
                <div class="form-group"><label>خلاصه‌ی کدی</label><label class="permission-item"><input type="checkbox" @bind="smsSettings.IncludeCodes" /><span>کد کالاها هم زیر متن بیاید</span></label></div>
                <div class="form-group"><label>پیشوند کدها</label><input class="form-input" @bind="smsSettings.Prefix" maxlength="10" disabled="@(!smsSettings.IncludeCodes)" /></div>
            </div>
            <div class="info-banner">
                راهنمای کدها: <strong>L</strong> موجودی کم، <strong>E</strong> در آستانه‌ی انقضا (۷ روز)، <strong>X</strong> منقضی‌شده؛ عدد بعد از حرف تعداد کالاهاست و بعد کد کالاها.
                در پیامک فوری <code>01014=0.5/2</code> یعنی موجودی ۰٫۵ و حد هشدار ۲ (به واحد موجودی).<br/>
                پیش‌نمایش پیامک امروز: <code style="white-space:pre-wrap;display:inline-block;vertical-align:top">@smsSettings.Compose(preview)</code>
            </div>
            @if (!string.IsNullOrEmpty(smsMessage)) { <div class="alert @(smsOk ? "alert-success" : "alert-error")">@smsMessage</div> }
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="SaveSms" disabled="@smsBusy">💾 ذخیره</button>
                <button class="btn btn-secondary" @onclick="SendTest" disabled="@(smsBusy || !Sms.IsConfigured)">ارسال آزمایشی</button>
                <button class="btn btn-secondary" @onclick="SendSummaryNow" disabled="@(smsBusy || !Sms.IsConfigured)">ارسال خلاصه همین الان</button>
            </div>
            @if (smsLogs.Any())
            {
                <details style="margin-top:.75rem" open="@logsOpen"><summary>آخرین پیامک‌ها (@smsLogs.Count)</summary>
                    <button class="btn btn-secondary btn-sm" style="margin:.5rem 0" @onclick="RefreshStatuses" disabled="@(smsBusy || !Sms.IsConfigured)">🔄 بررسی وضعیت تحویل</button>
                    <div class="table-responsive"><table class="data-table"><thead><tr><th>زمان</th><th>نوع</th><th>گیرنده</th><th>متن</th><th>نتیجه</th><th>وضعیت تحویل</th></tr></thead><tbody>
                    @foreach (var l in smsLogs) { <tr><td>@l.SentAt.ToShamsiWithTime()</td><td>@l.Kind</td><td dir="ltr">@l.Recipient</td><td dir="ltr" style="white-space:pre-wrap">@l.Message</td><td>@if (l.Success) {<span class="status-badge ok">ارسال شد</span>} else {<span class="status-badge danger" title="@l.Response">خطا</span>}<br/><small class="text-muted" dir="ltr">@l.Response</small></td><td dir="ltr"><small>@l.DeliveryStatus</small>@if (l.StatusCheckedAt.HasValue) {<br/><small class="text-muted">@l.StatusCheckedAt.Value.ToShamsiWithTime()</small>}</td></tr> }
                    </tbody></table></div>
                </details>
            }
        }
    </div>
}

<div class="search-bar">
    <input value="@search" @oninput="OnSearch" class="form-input search-input" placeholder="🔍 جستجو بر اساس نام یا کد..." />
</div>

@if (loaded)
{
    @if (!alerts.Any() && !invalidPrices.Any())
    {
        <div class="empty-state"><span class="empty-icon">✅</span><p>هیچ هشداری وجود ندارد.</p></div>
    }
    else
    {
        <div class="alerts-summary">
            <span class="badge-count red">@lowStock.Count موجودی کم</span>
            <span class="badge-count orange">@expiring.Count در آستانه انقضا</span>
            <span class="badge-count gray">@expired.Count منقضی شده</span>
            <span class="badge-count orange">@invalidPrices.Count قیمت نامعتبر</span>
        </div>

        @if(invalidPrices.Any())
        {
          <div class="section-title orange-title">💰 ورودی‌های فاقد قیمت معتبر</div>
          @foreach(var e in invalidPrices){<div class="alert-card warning"><div class="alert-header"><strong>[@e.Material?.Code] @e.Material?.Name</strong><span class="status-badge warning">@e.PricePerUnit.ToString("N0") ﷼</span></div><div class="alert-detail">@e.Warehouse?.Name | @e.EntryDate.ToShamsi() | مقدار @e.Quantity.ToString("N3")</div>@if(editingPriceId==e.Id){<div class="inline-form"><MoneyInput @bind-Value="correctPrice" /><button class="btn btn-primary btn-sm" @onclick="()=>CorrectPrice(e.Id)">ثبت مبلغ درست</button><button class="btn btn-secondary btn-sm" @onclick="()=>editingPriceId=null">انصراف</button></div>}else{<div class="form-actions"><button class="btn btn-success btn-sm" @onclick="()=>ConfirmPrice(e.Id)">تأیید همین مبلغ</button><button class="btn btn-warning btn-sm" @onclick="()=>EditPrice(e)">اصلاح مبلغ</button></div>}</div>}
        }

        @if (lowStock.Any())
        {
            <div class="section-title red-title">📉 نیاز به خرید</div>
            @foreach (var a in lowStock)
            {
                <div class="alert-card danger">
                    <div class="alert-header"><strong>[@a.MaterialCode] @a.MaterialName</strong><span class="status-badge danger">خرید</span></div>
                    <p>@a.Message</p>
                    <div class="alert-detail">موجودی: <strong>@a.CurrentStock @a.Unit</strong> | حد: <strong>@a.MinStockLevel @a.Unit</strong></div>
                </div>
            }
        }
        @if (expiring.Any())
        {
            <div class="section-title orange-title">⏰ در آستانه انقضا</div>
            @foreach (var a in expiring)
            {
                <div class="alert-card warning">
                    <div class="alert-header"><strong>[@a.MaterialCode] @a.MaterialName</strong><span class="status-badge warning">انقضا</span></div>
                    <p>@a.Message</p>
                    <div class="alert-detail">انقضا: <strong>@a.ExpiryDate?.ToString("yyyy/MM/dd")</strong></div>
                </div>
            }
        }
        @if (expired.Any())
        {
            <div class="section-title gray-title">❌ منقضی شده</div>
            @foreach (var a in expired)
            {
                <div class="alert-card expired">
                    <div class="alert-header"><strong>[@a.MaterialCode] @a.MaterialName</strong><span class="status-badge danger">منقضی</span></div>
                    <p>@a.Message</p>
                </div>
            }
        }
    }
}

@code {
    bool loaded; string search="";
    List<StockAlert> alerts=new(),lowStock=new(),expiring=new(),expired=new();
    List<StockEntry> invalidPrices=new(); int? editingPriceId; decimal correctPrice;

    bool logsOpen;
    async Task RefreshStatuses() { smsBusy = true; try { var n = await Sms.RefreshStatusesAsync(); smsLogs = await Sms.GetLogsAsync(); logsOpen = true; smsOk = true; smsMessage = n == 0 ? "پیامکی با شناسه‌ی ارسال (msgid) برای بررسی نیست" : $"وضعیت {n} پیامک از پنل گرفته شد"; } catch (Exception ex) { smsOk = false; smsMessage = ex.Message; } finally { smsBusy = false; } }
    SmsSettings? smsSettings; string recipientsText = "", preview = "", smsMessage = ""; bool smsOk, smsBusy; List<SmsLog> smsLogs = new();

    protected override async Task OnInitializedAsync() { await LoadAlerts(); if (Auth.IsAdmin) await LoadSms(); }
    async Task LoadSms()
    {
        smsSettings = await Sms.GetSettingsAsync(); recipientsText = string.Join(", ", smsSettings.Recipients.Select(r => r.StartsWith("98") ? "0" + r[2..] : r));
        preview = SmsText.Daily(smsSettings.Prefix, await Warehouse.GetAlertsAsync(), SmsAlertWorker.TehranNow());
        smsLogs = await Sms.GetLogsAsync();
    }
    async Task SaveSms()
    {
        smsBusy = true; smsMessage = "";
        try { smsSettings!.Recipients = recipientsText.Split(new[] { ',', '،', ';', ' ' }, StringSplitOptions.RemoveEmptyEntries).ToList(); await Sms.SaveSettingsAsync(smsSettings); await LoadSms(); smsOk = true; smsMessage = "✅ تنظیمات پیامک ذخیره شد"; }
        catch (Exception ex) { smsOk = false; smsMessage = ex.Message; }
        finally { smsBusy = false; }
    }
    async Task SendTest() => await Send(smsSettings!.Text, "test");
    async Task SendSummaryNow() => await Send(smsSettings!.Compose(preview), "daily-manual");
    async Task Send(string text, string kind)
    {
        smsBusy = true; smsMessage = "";
        try
        {
            if (smsSettings!.Recipients.Count == 0) throw new Exception("ابتدا شماره‌ی گیرنده را ذخیره کنید");
            var ok = await Sms.SendAsync(smsSettings.Recipients, text, kind);
            smsOk = ok == smsSettings.Recipients.Count; smsMessage = smsOk ? $"✅ به {ok} گیرنده ارسال شد" : $"⚠️ {ok} از {smsSettings.Recipients.Count} ارسال شد؛ جزئیات در «آخرین پیامک‌ها»";
            smsLogs = await Sms.GetLogsAsync();
        }
        catch (Exception ex) { smsOk = false; smsMessage = ex.Message; }
        finally { smsBusy = false; }
    }
    async Task Reload() { loaded=false; await LoadAlerts(); }
    async Task OnSearch(ChangeEventArgs e) { search=e.Value?.ToString()??""; await LoadAlerts(); }

    async Task LoadAlerts()
    {
        alerts=await Warehouse.GetAlertsAsync(search);
        lowStock=alerts.Where(a=>a.Type==AlertType.LowStock).ToList();
        expiring=alerts.Where(a=>a.Type==AlertType.Expiring).ToList();
        expired=alerts.Where(a=>a.Type==AlertType.Expired).ToList();
        invalidPrices=await Warehouse.GetInvalidPriceEntriesAsync(search);
        loaded=true;
    }
    void EditPrice(StockEntry e){editingPriceId=e.Id;correctPrice=e.PricePerUnit;}
    async Task ConfirmPrice(int id){await Warehouse.ConfirmEntryPriceAsync(id,Auth.CurrentUser!.Username);await LoadAlerts();}
    async Task CorrectPrice(int id){await Warehouse.CorrectEntryPriceAsync(id,correctPrice,Auth.CurrentUser!.Username);editingPriceId=null;await LoadAlerts();}
}
