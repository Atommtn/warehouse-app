@using WarehouseApp.Services
@using WarehouseApp.Models
@inject WarehouseService Warehouse
@inject AuthService Auth

<div class="page-header"><h2>⬇️ خروج مواد از انبار</h2></div>

<div class="form-card">
    <div class="form-grid">
        <div class="form-group"><label>انبار مبدأ *</label><select class="form-input" value="@warehouseId" @onchange="OnWarehouseChange"><option value="0">انتخاب کنید...</option>@foreach(var w in warehouses){<option value="@w.Id">@w.Name</option>}</select></div>
        <div class="form-group">
            <label>ماده اولیه *</label>
            <input value="@materialSearch" @oninput="OnMaterialSearch" class="form-input" placeholder="🔍 جستجوی نام یا کد ماده..." />
            <select value="@selId" @onchange="OnMaterialChange" class="form-input">
                <option value="0">انتخاب کنید...</option>
                @foreach (var m in materials) { <option value="@m.Id">[@m.Code] @m.Name — @m.CurrentStock.ToString("N3") @m.BaseUnitName</option> }
            </select>
            @if (sel != null) { <small class="form-hint">موجودی این انبار: @selectedStock.ToString("N3") @sel.BaseUnitName</small> }
        </div>
        <div class="form-group">
            <label>مقدار *</label>
            <input @bind="qty" type="number" step="0.01" class="form-input" />
        </div>
        <div class="form-group"><label>واحد خروج *</label><select class="form-input" @bind="selectedUnit"><option value="">انتخاب کنید...</option>@foreach(var u in materialUnits){<option value="@u.UnitName">@u.UnitName</option>}</select></div>
        <div class="form-group">
            <label>تاریخ خروج *</label>
            <PersianDatePicker Value="@wDate" ValueChanged="@(d => wDate = d)" Placeholder="1403/01/15" />
        </div>
        <div class="form-group">
            <label>مصرف در بخش *</label>
            <input @bind="department" list="withdrawal-departments" class="form-input" placeholder="مثال: تولید نان، شیرینی‌پزی، فروشگاه" />
            <datalist id="withdrawal-departments">@foreach(var d in departments){<option value="@d"></option>}</datalist>
        </div>
        <div class="form-group">
            <label>دلیل خروج</label>
            <input @bind="reason" class="form-input" placeholder="مثال: مصرف در تولید" />
        </div>
    </div>
    @if (!string.IsNullOrEmpty(ok))  { <div class="alert alert-success">@ok</div> }
    @if (!string.IsNullOrEmpty(err)) { <div class="alert alert-error">@err</div> }
    <div class="form-actions">
        <button class="btn btn-primary" @onclick="Submit">
            ✅ ثبت خروج
        </button>
        <button class="btn btn-secondary" @onclick="Reset">پاک کردن</button>
    </div>
</div>

@if (editing != null)
{
    <div class="form-card edit-card">
        <h3>✏️ ویرایش خروج — [@editing.Material?.Code] @editing.Material?.Name (@editing.Warehouse?.Name)</h3>
        <div class="form-grid">
            <div class="form-group"><label>مقدار *</label><input @bind="eQty" type="number" step="0.001" class="form-input" /></div>
            <div class="form-group"><label>واحد خروج *</label><select class="form-input" @bind="eUnit">@foreach(var u in editUnits){<option value="@u.UnitName">@u.UnitName</option>}</select></div>
            <div class="form-group"><label>تاریخ خروج *</label><PersianDatePicker Value="@eDate" ValueChanged="@(d => eDate = d)" /></div>
            <div class="form-group"><label>مصرف در بخش *</label><input @bind="eDepartment" list="withdrawal-departments" class="form-input" /></div>
            <div class="form-group"><label>دلیل خروج</label><input @bind="eReason" class="form-input" /></div>
        </div>
        @if (!string.IsNullOrEmpty(editErr)) { <div class="alert alert-error">@editErr</div> }
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="SaveEdit">💾 ذخیره تغییرات</button>
            <button class="btn btn-secondary" @onclick="()=>editing=null">انصراف</button>
        </div>
    </div>
}

<div class="section-title">خروجی‌ها</div>
<div class="search-bar list-filters">
    <input value="@withdrawalSearch" @oninput="OnWithdrawalSearch" class="form-input search-input" placeholder="🔍 جستجو در خروجی‌ها بر اساس نام یا کد ماده یا بخش..." />
    <select class="form-input period-select" value="@period" @onchange="OnPeriodChange">@foreach(var p in PeriodFilter.Options){<option value="@p.Key">@p.Label</option>}</select>
</div>
<div class="table-responsive">
    <table class="data-table">
        <thead><tr><th>انبار</th><th>کد</th><th>ماده</th><th>مقدار</th><th>بخش مصرف‌کننده</th><th>تاریخ</th><th>کاربر</th><th>وضعیت</th>@if(Auth.IsManager){<th></th>}</tr></thead>
        <tbody>
            @foreach (var w in withdrawals)
            {
                <tr>
                    <td>@w.Warehouse?.Name</td>
                    <td><code>@w.Material?.Code</code></td>
                    <td>@w.Material?.Name</td>
                    <td>@w.EnteredQuantity.ToString("N3") @w.EnteredUnitName <small class="text-muted">= @w.Quantity.ToString("N3") @w.Material?.BaseUnitName</small></td>
                    <td>@w.Department</td>
                    <td>@w.WithdrawalDate.ToShamsi()</td>
                    <td>@w.CreatedByUsername</td>
                    <td>
                        @if (w.Status == WithdrawalStatus.Pending)   { <span class="status-badge warning">در انتظار</span> }
                        else if (w.Status == WithdrawalStatus.Approved) { <span class="status-badge ok">تایید</span> }
                        else { <span class="status-badge danger">رد شد</span> }
                    </td>
                    @if (Auth.IsManager) { <td><button class="btn-icon" @onclick="()=>StartEdit(w)" title="ویرایش">✏️</button></td> }
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    List<Material> materials=new(); List<StockWithdrawal> withdrawals=new(); List<Warehouse> warehouses=new();
    int warehouseId; decimal selectedStock;
    Material? sel; int selId=0; decimal qty=0; string reason="",department="",ok="",err="",selectedUnit="";List<MaterialUnitConversion> materialUnits=new();List<string> departments=new();
    DateTime wDate=DateTime.Today;
    string materialSearch="", withdrawalSearch="", period="month";
    StockWithdrawal? editing; decimal eQty; string eUnit="", eDepartment="", eReason="", editErr=""; DateTime eDate; List<MaterialUnitConversion> editUnits=new();

    protected override async Task OnInitializedAsync() => await Load();

    async Task Load()
    {
        materials = await Warehouse.GetMaterialsAsync();
        warehouses = await Warehouse.GetWarehousesAsync(); if(warehouseId==0) warehouseId=warehouses.FirstOrDefault()?.Id??0;
        withdrawals = await Warehouse.GetWithdrawalsAsync(search: withdrawalSearch, from: PeriodFilter.Start(period));
        var known = new[] { "تولید نان", "شیرینی‌پزی", "فروشگاه", "آشپزخانه" };
        departments = known.Union(await Warehouse.GetWithdrawalDepartmentsAsync()).ToList();
    }

    async Task OnMaterialChange(ChangeEventArgs e)
    {
        selId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        sel = materials.FirstOrDefault(m => m.Id == selId);
        materialUnits=selId>0?await Warehouse.GetMaterialUnitsAsync(selId):new();selectedUnit=materialUnits.FirstOrDefault()?.UnitName??"";
        selectedStock=warehouseId>0&&selId>0?await Warehouse.GetWarehouseStockAsync(warehouseId,selId):0;
    }
    async Task OnWarehouseChange(ChangeEventArgs e){warehouseId=int.TryParse(e.Value?.ToString(),out var id)?id:0;selectedStock=warehouseId>0&&selId>0?await Warehouse.GetWarehouseStockAsync(warehouseId,selId):0;}

    async Task OnMaterialSearch(ChangeEventArgs e)
    {
        materialSearch = e.Value?.ToString() ?? "";
        materials = await Warehouse.GetMaterialsAsync(materialSearch);
    }

    async Task OnWithdrawalSearch(ChangeEventArgs e)
    {
        withdrawalSearch = e.Value?.ToString() ?? "";
        withdrawals = await Warehouse.GetWithdrawalsAsync(search: withdrawalSearch, from: PeriodFilter.Start(period));
    }

    async Task Submit()
    {
        ok=""; err="";
        if (selId==0) { err="ماده را انتخاب کنید"; return; }
        if (warehouseId==0) { err="انبار مبدأ را انتخاب کنید"; return; }
        if (qty<=0)   { err="مقدار باید بیشتر از صفر باشد"; return; }
        if (string.IsNullOrWhiteSpace(department)) { err="بخش مصرف‌کننده را مشخص کنید"; return; }
        try
        {
            await Warehouse.AddWithdrawalAsync(new StockWithdrawal
            {
                MaterialId=selId, WarehouseId=warehouseId, EnteredQuantity=qty,EnteredUnitName=selectedUnit,Quantity=qty, WithdrawalDate=wDate, Reason=reason, Department=department.Trim(),
                CreatedByUserId=Auth.CurrentUser!.Id, CreatedByUsername=Auth.CurrentUser.Username,
                Status = WithdrawalStatus.Approved
            });
            ok = $"✅ {qty} {selectedUnit} از [{sel?.Code}] {sel?.Name} برای بخش {department.Trim()} در {wDate.ToShamsi()} ثبت شد";
            await Load(); Reset();
        }
        catch (Exception ex) { err = $"❌ {ex.Message}"; }
    }

    void Reset() { selId=0; qty=0; sel=null; wDate=DateTime.Today; reason=""; }

    async Task OnPeriodChange(ChangeEventArgs e) { period = e.Value?.ToString() ?? "month"; withdrawals = await Warehouse.GetWithdrawalsAsync(search: withdrawalSearch, from: PeriodFilter.Start(period)); }

    async Task StartEdit(StockWithdrawal w)
    {
        editing = w; eQty = w.EnteredQuantity > 0 ? w.EnteredQuantity : w.Quantity; eUnit = w.EnteredUnitName; eDate = w.WithdrawalDate;
        eDepartment = w.Department; eReason = w.Reason; editErr = "";
        editUnits = await Warehouse.GetMaterialUnitsAsync(w.MaterialId);
        if (!editUnits.Any(u => u.UnitName == eUnit)) eUnit = editUnits.FirstOrDefault()?.UnitName ?? "";
    }

    async Task SaveEdit()
    {
        editErr = "";
        try
        {
            await Warehouse.UpdateWithdrawalAsync(new StockWithdrawal { Id = editing!.Id, EnteredQuantity = eQty, EnteredUnitName = eUnit, WithdrawalDate = eDate, Department = eDepartment, Reason = eReason }, Auth.CurrentUser!.Id, Auth.CurrentUser.Username);
            ok = $"✅ خروج [{editing.Material?.Code}] {editing.Material?.Name} ویرایش شد"; editing = null;
            await Load();
        }
        catch (Exception ex) { editErr = $"❌ {ex.Message}"; }
    }
}
