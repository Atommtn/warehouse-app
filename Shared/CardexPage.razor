@using WarehouseApp.Models
@using WarehouseApp.Services
@inject WarehouseService WarehouseService
@inject IJSRuntime JS

<div class="page-header"><h2>📒 کاردکس کالا</h2></div>
<div class="form-card"><div class="form-grid">
 <div class="form-group"><label>جستجو</label><input class="form-input" @bind="search" placeholder="نام، کد کالا یا شماره سند" /></div>
 <div class="form-group"><label>انبار</label><select class="form-input" @bind="warehouseId"><option value="0">همه انبارها</option>@foreach(var w in warehouses){<option value="@w.Id">@w.Name</option>}</select></div>
 <div class="form-group"><label>کالا</label><select class="form-input" @bind="materialId"><option value="0">همه کالاها</option>@foreach(var m in materials){<option value="@m.Id">[@m.Code] @m.Name</option>}</select></div>
</div><button class="btn btn-primary" @onclick="Load">نمایش</button> <button class="btn btn-success" @onclick="Export">خروجی حسابداری (CSV)</button></div>
<div class="table-responsive"><table class="data-table"><thead><tr><th>تاریخ</th><th>سند</th><th>نوع</th><th>انبار</th><th>کد</th><th>کالا</th><th>ورود</th><th>خروج</th><th>مانده</th><th>فی</th><th>کاربر</th><th>شرح</th></tr></thead><tbody>
@foreach(var x in rows){<tr><td>@x.TransactionDate.ToShamsi()</td><td><code>@x.DocumentNumber</code></td><td>@TypeName(x.Type)</td><td>@x.Warehouse?.Name@if(x.RelatedWarehouse!=null){<small> ←→ @x.RelatedWarehouse.Name</small>}</td><td><code>@x.Material?.Code</code></td><td>@x.Material?.Name</td><td>@(x.IncomingQuantity==0?"-":x.IncomingQuantity.ToString("N3"))</td><td>@(x.OutgoingQuantity==0?"-":x.OutgoingQuantity.ToString("N3"))</td><td>@x.BalanceAfter.ToString("N3")</td><td>@x.UnitPrice.ToString("N0")</td><td>@x.CreatedByUsername</td><td>@x.Description</td></tr>}
</tbody></table></div>
@code{List<Warehouse> warehouses=new();List<Material> materials=new();List<InventoryTransaction> rows=new();int warehouseId,materialId;string search="";protected override async Task OnInitializedAsync(){warehouses=await WarehouseService.GetWarehousesAsync();materials=await WarehouseService.GetMaterialsAsync();await Load();}async Task Load()=>rows=await WarehouseService.GetCardexAsync(materialId==0?null:materialId,warehouseId==0?null:warehouseId,search);string TypeName(InventoryTransactionType t)=>t switch{InventoryTransactionType.OpeningBalance=>"مانده اول دوره",InventoryTransactionType.Entry=>"ورود",InventoryTransactionType.Withdrawal=>"خروج",InventoryTransactionType.TransferIn=>"انتقال ورودی",InventoryTransactionType.TransferOut=>"انتقال خروجی",_=>"اصلاح"};async Task Export(){var b=new System.Text.StringBuilder("تاریخ,شماره سند,نوع,کد تفصیلی انبار,انبار,کد کالا,نام کالا,ورود,خروج,مانده,فی,کاربر,شرح\n");foreach(var x in rows)b.AppendLine($"{x.TransactionDate:yyyy/MM/dd},{x.DocumentNumber},{TypeName(x.Type)},{x.Warehouse?.AccountingDetailCode},{x.Warehouse?.Name},{x.Material?.Code},{x.Material?.Name},{x.IncomingQuantity},{x.OutgoingQuantity},{x.BalanceAfter},{x.UnitPrice},{x.CreatedByUsername},{x.Description?.Replace(',', ' ')}");var bytes=System.Text.Encoding.UTF8.GetPreamble().Concat(System.Text.Encoding.UTF8.GetBytes(b.ToString())).ToArray();await JS.InvokeVoidAsync("downloadFile",Convert.ToBase64String(bytes),"accounting-cardex.csv");}}
