@using WarehouseApp.Models
@using WarehouseApp.Services
@inject WarehouseService WarehouseService
@inject IJSRuntime JS

<div class="page-header"><h2>📒 کاردکس کالا</h2></div>
<div class="form-card"><div class="form-grid">
 <div class="form-group"><label>جستجو</label><input class="form-input" @bind="search" @bind:event="oninput" @bind:after="Load" placeholder="نام، کد کالا یا شماره سند" /></div>
 <div class="form-group"><label>انبار</label><select class="form-input" @bind="warehouseId" @bind:after="Load"><option value="0">همه انبارها</option>@foreach(var w in warehouses){<option value="@w.Id">@w.Name</option>}</select></div>
 <div class="form-group"><label>کالا</label><MaterialPicker Items="materials" Value="materialId" ValueChanged="async id=>{materialId=id;await Load();}" EmptyText="همه کالاها" Placeholder="🔍 همه کالاها؛ برای انتخاب تایپ کنید..." /></div>
</div><button class="btn btn-primary" @onclick="Load">نمایش</button> <button class="btn btn-success" @onclick="Export">خروجی حسابداری (CSV)</button></div>
@if(materialId>0){var mat=materials.First(x=>x.Id==materialId);<div class="stats-grid"><div class="stat-card blue"><div class="stat-icon">⬆️</div><div class="stat-info"><div class="stat-value">@rows.Sum(x=>x.IncomingQuantity).ToString("N3")</div><div class="stat-label">مجموع ورود (@mat.BaseUnitName)</div></div></div><div class="stat-card orange"><div class="stat-icon">⬇️</div><div class="stat-info"><div class="stat-value">@rows.Sum(x=>x.OutgoingQuantity).ToString("N3")</div><div class="stat-label">مجموع خروج (@mat.BaseUnitName)</div></div></div><div class="stat-card green"><div class="stat-icon">📦</div><div class="stat-info"><div class="stat-value">@display.Format(currentStocks.Sum(x=>x.Quantity),mat)</div><div class="stat-label">موجودی فعلی</div></div></div></div><div class="warehouse-balance-list">@foreach(var s in currentStocks){<span class="status-badge ok">@s.Warehouse?.Name: @display.Format(s.Quantity,mat)</span>}</div>}
<div class="table-responsive"><table class="data-table"><thead><tr><th>تاریخ</th><th>سند</th><th>نوع</th><th>انبار</th><th>کد</th><th>کالا</th><th>ورود</th><th>خروج</th><th>مانده</th><th>فی</th><th>کاربر</th><th>شرح</th></tr></thead><tbody>
@foreach(var x in rows){<tr><td>@x.TransactionDate.ToShamsi()</td><td><code>@x.DocumentNumber</code></td><td>@TypeName(x.Type)</td><td>@x.Warehouse?.Name@if(x.RelatedWarehouse!=null){<small> ←→ @x.RelatedWarehouse.Name</small>}</td><td><code>@x.Material?.Code</code></td><td>@x.Material?.Name</td><td>@(x.IncomingQuantity==0?"-":x.IncomingQuantity.ToString("N3"))</td><td>@(x.OutgoingQuantity==0?"-":x.OutgoingQuantity.ToString("N3"))</td><td>@x.BalanceAfter.ToString("N3")</td><td>@x.UnitPrice.ToString("N0")</td><td>@x.CreatedByUsername</td><td>@x.Description</td></tr>}
</tbody></table></div>
@code{StockDisplay display=StockDisplay.Empty;List<Warehouse> warehouses=new();List<Material> materials=new();List<InventoryTransaction> rows=new();List<WarehouseStock> currentStocks=new();int warehouseId,materialId;string search="";protected override async Task OnInitializedAsync(){display=await WarehouseService.GetStockDisplayAsync();warehouses=await WarehouseService.GetWarehousesAsync();materials=await WarehouseService.GetMaterialsAsync();await Load();}int loadVersion;async Task Load(){var v=++loadVersion;var r=await WarehouseService.GetCardexAsync(materialId==0?null:materialId,warehouseId==0?null:warehouseId,search);var s=materialId==0?new():(await WarehouseService.GetWarehouseStocksAsync(warehouseId==0?null:warehouseId)).Where(x=>x.MaterialId==materialId).ToList();if(v!=loadVersion)return;rows=r;currentStocks=s;}string TypeName(InventoryTransactionType t)=>t switch{InventoryTransactionType.OpeningBalance=>"مانده اول دوره",InventoryTransactionType.Entry=>"ورود",InventoryTransactionType.Withdrawal=>"خروج",InventoryTransactionType.TransferIn=>"انتقال ورودی",InventoryTransactionType.TransferOut=>"انتقال خروجی",_=>"اصلاح مغایرت"};async Task Export(){var b=new System.Text.StringBuilder("تاریخ,شماره سند,نوع,کد تفصیلی انبار,انبار,کد کالا,نام کالا,ورود,خروج,مانده,فی,کاربر,شرح\n");foreach(var x in rows)b.AppendLine($"{x.TransactionDate:yyyy/MM/dd},{x.DocumentNumber},{TypeName(x.Type)},{x.Warehouse?.AccountingDetailCode},{x.Warehouse?.Name},{x.Material?.Code},{x.Material?.Name},{x.IncomingQuantity},{x.OutgoingQuantity},{x.BalanceAfter},{x.UnitPrice},{x.CreatedByUsername},{x.Description?.Replace(',', ' ')}");var bytes=System.Text.Encoding.UTF8.GetPreamble().Concat(System.Text.Encoding.UTF8.GetBytes(b.ToString())).ToArray();await JS.InvokeVoidAsync("downloadFile",Convert.ToBase64String(bytes),"accounting-cardex.csv");}}
