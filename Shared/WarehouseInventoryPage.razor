@using WarehouseApp.Models
@using WarehouseApp.Services
@inject WarehouseService Service
<div class="page-header"><h2>📦 موجودی تفکیکی انبارها</h2></div>
<div class="form-card"><div class="form-grid"><div class="form-group"><label>انبار</label><select class="form-input" @bind="warehouseId" @bind:after="Load"><option value="0">همه انبارها</option>@foreach(var w in warehouses){<option value="@w.Id">@w.Name</option>}</select></div><div class="form-group"><label>جستجو</label><input class="form-input" @bind="search" @bind:event="oninput" placeholder="نام یا کد کالا..." /></div></div></div>
<div class="table-responsive"><table class="data-table"><thead><tr><th>انبار</th><th>کد</th><th>کالا</th><th>موجودی</th><th>واحد</th><th>حد هشدار</th><th>وضعیت</th></tr></thead><tbody>@foreach(var x in Filtered){<tr class="@(x.Quantity<=x.MinStockLevel?"row-warning":"")"><td>@x.Warehouse?.Name</td><td><code>@x.Material?.Code</code></td><td>@x.Material?.Name</td><td>@x.Quantity.ToString("N3")</td><td>@x.Material?.BaseUnitName</td><td>@x.MinStockLevel.ToString("N3")</td><td>@(x.Quantity<=x.MinStockLevel?"نیازمند خرید":"موجود")</td></tr>}</tbody></table></div>
@code{List<Warehouse> warehouses=new();List<WarehouseStock> rows=new();int warehouseId;string search="";IEnumerable<WarehouseStock> Filtered=>string.IsNullOrWhiteSpace(search)?rows:rows.Where(x=>x.Material!.Name.Contains(search,StringComparison.OrdinalIgnoreCase)||x.Material.Code.Contains(search,StringComparison.OrdinalIgnoreCase));protected override async Task OnInitializedAsync(){warehouses=await Service.GetWarehousesAsync();await Load();}async Task Load()=>rows=await Service.GetWarehouseStocksAsync(warehouseId==0?null:warehouseId);}
