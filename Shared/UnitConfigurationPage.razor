@using WarehouseApp.Models
@using WarehouseApp.Services
@inject WarehouseService Service
@inject AuthService Auth

<div class="page-header"><h2>⚖️ واحدهای کالا</h2></div>
<div class="info-banner">
    <strong>واحد موجودی</strong> واحدی است که انبار با آن شمرده می‌شود (مثلاً کارتن). همه‌ی موجودی‌ها و سوابق با همین واحد نگه داشته می‌شوند.<br/>
    <strong>واحد رسپی</strong> فقط مبنای قیمت و هزینه‌ی رسپی است (مثلاً کیلوگرم) و روی موجودی اثری ندارد.<br/>
    بقیه‌ی واحدها را بر حسب هر واحد دیگری بنویسید؛ گرم و کیلوگرم (و لیتر و میلی‌لیتر) خودشان به هم تبدیل می‌شوند.
    رابطه‌هایی که دقیق نیستند (مثل وزن هر تخم‌مرغ) را <span class="approx">تقریبی</span> بزنید؛ تغییر آن‌ها فقط قیمت رسپی را عوض می‌کند، نه موجودی را.<br/>
    مثال تخم‌مرغ: ۱ کارتن = ۶ شانه، ۱ شانه = ۳۰ عدد، ۱ عدد ≈ ۷۰ گرم؛ واحد موجودی «کارتن» و واحد رسپی «کیلوگرم».
</div>

<div class="form-card">
    <div class="form-grid">
        <div class="form-group"><label>کالا</label><MaterialPicker Materials="materials" SelectedId="materialId" SelectedIdChanged="SelectMaterial" Detail="@(m => m.StockUnitName)" /></div>
        @if (material != null)
        {
            <div class="form-group"><label>واحد موجودی</label><select class="form-input" value="@stockUnit" @onchange="StockUnitChanged">@foreach (var u in UnitChoices) {<option value="@u">@u</option>}</select><small class="form-hint">انبار با این واحد شمرده می‌شود</small></div>
            <div class="form-group"><label>واحد رسپی</label><select class="form-input" @bind="recipeUnit" @bind:after="Preview">@foreach (var u in UnitChoices) {<option value="@u">@u</option>}</select><small class="form-hint">مبنای قیمت و هزینه‌ی رسپی</small></div>
        }
    </div>
</div>

@if (material != null)
{
    <div class="form-card">
        <h3>رابطه‌ی واحدهای @material.Name</h3>
        @foreach (var row in rows)
        {
            <div class="unit-row">
                <input class="form-input num" type="number" step="any" min="0" value="@N(row.Count)" @onchange="e => { row.Count = D(e); Preview(); }" />
                <select class="form-input" value="@row.Unit" @onchange="e => Rename(row, e)"><option value="">واحد...</option>@foreach (var u in UnitChoices.Where(x => !UnitSet.Same(x, stockUnit))) {<option value="@u">@u</option>}</select>
                <span>=</span>
                <input class="form-input num" type="number" step="any" min="0" value="@N(row.Amount)" @onchange="e => { row.Amount = D(e); Preview(); }" />
                <select class="form-input" value="@row.Ref" @onchange="e => { row.Ref = e.Value?.ToString() ?? stockUnit; Preview(); }">@foreach (var u in RefChoices(row)) {<option value="@u">@u</option>}</select>
                <label class="permission-item"><input type="checkbox" checked="@row.Approximate" @onchange="e => { row.Approximate = e.Value is true; Preview(); }" /><span>تقریبی</span></label>
                <button class="btn-icon" title="حذف" @onclick="() => { rows.Remove(row); Preview(); }">🗑️</button>
                @if (perStock.TryGetValue(row.Unit, out var p)) { <span class="result">هر ۱ @stockUnit = @(p.Approx ? "≈ " : "")@N(p.Per) @row.Unit</span> }
            </div>
        }
        <button class="btn btn-secondary btn-sm" @onclick="AddRow">+ افزودن واحد</button>
        <small class="text-muted"> واحد جدید را از «تعاریف اولیه ← تعریف واحد» بسازید.</small>

        @if (!string.IsNullOrEmpty(previewError)) { <div class="alert alert-error">@previewError</div> }
        else
        {
            <div class="table-responsive"><table class="data-table unit-table">
                <thead><tr><th>واحد</th><th>در هر ۱ @stockUnit</th>@if (Auth.CanViewPrice && material.PricePerUnit > 0) {<th>قیمت هر واحد (آخرین خرید)</th>}<th></th></tr></thead>
                <tbody>
                    @foreach (var (name, p) in perStock.OrderBy(x => x.Value.Per))
                    {
                        <tr>
                            <td><strong>@name</strong>@if (UnitSet.Same(name, stockUnit)) {<span class="status-badge ok">موجودی</span>} @if (UnitSet.Same(name, recipeUnit)) {<span class="status-badge warning">رسپی</span>}</td>
                            <td>@(p.Approx ? "≈ " : "")@N(p.Per)</td>
                            @if (Auth.CanViewPrice && material.PricePerUnit > 0) {<td>@(p.Approx ? "≈ " : "")@UnitSet.N(PricePerStock / p.Per, 0) ریال</td>}
                            <td>@if (p.Approx) {<span class="approx">تقریبی</span>}</td>
                        </tr>
                    }
                </tbody>
            </table></div>
            @if (StockUnitChanging && conversion is decimal k)
            {
                <div class="alert alert-error">واحد موجودی از «@material.StockUnitName» به «@stockUnit» تغییر می‌کند: موجودی فعلی @UnitSet.N(material.CurrentStock) @material.StockUnitName به @UnitSet.N(material.CurrentStock / k) @stockUnit تبدیل می‌شود و همه‌ی سوابق هم با همین نسبت نوشته می‌شوند.</div>
            }
        }
        @if (!string.IsNullOrEmpty(message)) { <div class="alert @(success ? "alert-success" : "alert-error")">@message</div> }
        <div class="form-actions">
            <button class="btn btn-primary" disabled="@(busy || !string.IsNullOrEmpty(previewError))" @onclick="Save">💾 ذخیره واحدها</button>
            <button class="btn btn-secondary" @onclick="() => SelectMaterial(materialId)">بازگردانی</button>
        </div>
    </div>
}

@code {
    class Row { public string Unit = ""; public decimal Count = 1; public decimal Amount = 1; public string Ref = ""; public bool Approximate; }

    List<Material> materials = new(); List<Unit> availableUnits = new(); List<Row> rows = new();
    Material? material; int materialId; string stockUnit = "", recipeUnit = "", message = "", previewError = ""; bool success, busy;
    Dictionary<string, (decimal Per, bool Approx)> perStock = new(StringComparer.OrdinalIgnoreCase);
    decimal? conversion; // old stock units in one new stock unit
    decimal PricePerStock => material == null ? 0 : conversion is decimal k && StockUnitChanging ? material.PricePerUnit * k : material.PricePerUnit;
    bool StockUnitChanging => material != null && !UnitSet.Same(material.StockUnitName, stockUnit);

    static string N(decimal v) => v.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture);
    static decimal D(ChangeEventArgs e) => decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var v) && v > 0 ? v : 0;

    IEnumerable<string> UnitChoices => availableUnits.Select(x => x.Name).Concat(new[] { "کیلوگرم", "گرم", "لیتر", "میلی‌لیتر", "عدد" })
        .Concat(rows.Select(x => x.Unit)).Append(stockUnit).Append(recipeUnit).Append(material?.StockUnitName ?? "")
        .Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase);
    IEnumerable<string> RefChoices(Row row) => new[] { stockUnit }.Concat(rows.Where(x => x != row).Select(x => x.Unit))
        .Concat(UnitSet.Standard.Keys.Where(k => k is "گرم" or "کیلوگرم" or "لیتر" or "میلی‌لیتر")).Append(row.Ref)
        .Where(x => !string.IsNullOrWhiteSpace(x) && !UnitSet.Same(x, row.Unit)).Distinct(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync() { materials = await Service.GetMaterialsAsync(); availableUnits = await Service.GetUnitsAsync(); }

    async Task SelectMaterial(int id)
    {
        materialId = id; message = ""; rows.Clear();
        material = materials.FirstOrDefault(x => x.Id == id);
        if (material == null) return;
        stockUnit = material.StockUnitName; recipeUnit = material.RecipeUnitName;
        foreach (var r in await Service.GetMaterialUnitRowsAsync(id))
        {
            if (UnitSet.Same(r.UnitName, stockUnit)) continue;
            rows.Add(string.IsNullOrWhiteSpace(r.DefinedRefUnit) || r.DefinedAmount <= 0 || UnitSet.Same(r.DefinedRefUnit, r.UnitName)
                ? new Row { Unit = r.UnitName, Count = r.PerStockUnit, Amount = 1, Ref = stockUnit, Approximate = r.IsApproximate }
                : new Row { Unit = r.UnitName, Count = r.DefinedCount, Amount = r.DefinedAmount, Ref = r.DefinedRefUnit, Approximate = r.IsApproximate });
        }
        Preview();
    }

    void AddRow() { rows.Add(new Row { Ref = stockUnit, Count = 1, Amount = 0 }); Preview(); }
    void Rename(Row row, ChangeEventArgs e)
    {
        var name = e.Value?.ToString() ?? "";
        if (rows.Any(x => x != row && UnitSet.Same(x.Unit, name))) { message = $"واحد «{name}» قبلاً اضافه شده است"; success = false; return; }
        foreach (var r in rows.Where(r => UnitSet.Same(r.Ref, row.Unit) && row.Unit != "")) r.Ref = name;
        row.Unit = name; Preview();
    }

    // Making another unit the stock unit: its row disappears and the previous stock unit gets a row in terms of it.
    void StockUnitChanged(ChangeEventArgs e)
    {
        var next = e.Value?.ToString() ?? ""; if (next == "" || UnitSet.Same(next, stockUnit)) return;
        var old = stockUnit; var pers = perStock;
        var nextRow = rows.FirstOrDefault(r => UnitSet.Same(r.Unit, next));
        if (nextRow != null) rows.Remove(nextRow);
        if (!rows.Any(r => UnitSet.Same(r.Unit, old)))
        {
            if (nextRow != null && UnitSet.Same(nextRow.Ref, old)) rows.Insert(0, new Row { Unit = old, Count = nextRow.Amount, Amount = nextRow.Count, Ref = next, Approximate = nextRow.Approximate });
            else if (pers.TryGetValue(next, out var p)) rows.Insert(0, new Row { Unit = old, Count = p.Per, Amount = 1, Ref = next, Approximate = p.Approx });
            else rows.Insert(0, new Row { Unit = old, Count = 1, Amount = 0, Ref = next });
        }
        foreach (var r in rows.Where(r => string.IsNullOrWhiteSpace(r.Ref))) r.Ref = next;
        stockUnit = next; Preview();
    }

    List<MaterialUnitConversion> ToConversions() =>
        rows.Where(r => !string.IsNullOrWhiteSpace(r.Unit))
            .Select(r => new MaterialUnitConversion { UnitName = r.Unit, DefinedCount = r.Count, DefinedAmount = r.Amount, DefinedRefUnit = r.Ref, IsApproximate = r.Approximate, IsActive = true })
            .Prepend(new MaterialUnitConversion { UnitName = stockUnit, IsActive = true }).ToList();

    void Preview()
    {
        previewError = ""; perStock.Clear(); conversion = null;
        try
        {
            var list = ToConversions();
            UnitSet.Resolve(stockUnit, list);
            var set = new UnitSet(stockUnit, recipeUnit, list);
            foreach (var u in set.Units.Where(u => !u.IsDerived || UnitSet.Same(u.Name, recipeUnit) || u.Name is "کیلوگرم" or "گرم" or "لیتر")) perStock[u.Name] = (u.PerStockUnit, u.IsApproximate);
            if (!set.Has(recipeUnit)) previewError = $"رابطه‌ی واحد رسپی «{recipeUnit}» با {stockUnit} را مشخص کنید";
            if (StockUnitChanging) { if (set.Has(material!.StockUnitName)) conversion = set.PerStockUnit(material.StockUnitName); else previewError = $"واحد موجودی قبلی «{material.StockUnitName}» را در لیست نگه دارید تا موجودی فعلی تبدیل شود"; }
        }
        catch (Exception ex) { previewError = ex.Message; }
    }

    async Task Save()
    {
        busy = true; message = "";
        try
        {
            await Service.SaveMaterialUnitsAsync(materialId, stockUnit, recipeUnit, ToConversions());
            materials = await Service.GetMaterialsAsync();
            await SelectMaterial(materialId);
            success = true; message = "✅ واحدها ذخیره شد.";
        }
        catch (Exception ex) { success = false; message = ex.Message; }
        finally { busy = false; }
    }
}
