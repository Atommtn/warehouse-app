@using WarehouseApp.Services
@using WarehouseApp.Models
@inject WarehouseService Warehouse
@inject AuthService Auth

<div class="page-header"><h2>⬆️ ورود مواد به انبار</h2></div>

@if (!editMode)
{
    <div class="form-card">
        <div class="form-grid">
            <div class="form-group"><label>انبار مقصد *</label><select @bind="warehouseId" class="form-input"><option value="0">انتخاب کنید...</option>@foreach(var w in warehouses){<option value="@w.Id">@w.Name</option>}</select></div>
            <div class="form-group">
                <label>ماده اولیه *</label>
                <input value="@materialSearch" @oninput="e=>materialSearch=e.Value?.ToString()??string.Empty" class="form-input" placeholder="🔍 جستجوی نام یا کد ماده..." />
                <select value="@selId" @onchange="OnMaterialChange" class="form-input">
                    <option value="0">انتخاب کنید...</option>
                    @foreach (var m in FilteredMaterials) { <option value="@m.Id">[@m.Code] @m.Name</option> }
                </select>
            </div>
            <div class="form-group">
                <label>مقدار *</label>
                <input @bind="qty" type="number" step="0.01" class="form-input" />
            </div>
            <div class="form-group"><label>واحد ورود *</label><select class="form-input" @bind="selectedUnit" @bind:after="RecalcPrice"><option value="">انتخاب کنید...</option>@foreach(var u in materialUnits){<option value="@u.UnitName">@u.UnitName (هر ۱ @u.UnitName = @u.FactorToBaseUnit.ToString("0.###") @selectedMaterial?.BaseUnitName)</option>}</select></div>
            @if (Auth.CanViewPrice)
            {
                <div class="form-group">
                    <label>فی خرید هر @(selectedMaterial?.BaseUnitName ?? "واحد پایه") (ریال)</label>
                    <input @bind="basePrice" @bind:after="RecalcPrice" type="number" class="form-input" />
                </div>
                <div class="form-group">
                    <label>قیمت هر @selectedUnit (ریال) *</label>
                    <input @bind="price" @bind:after="RecalcBasePrice" type="number" class="form-input" />
                    @if (qty > 0 && price > 0) { <small class="text-muted">جمع: @((qty * price).ToString("N0")) ریال</small> }
                </div>
            }
            <div class="form-group">
                <label>تاریخ ورود *</label>
                <PersianDatePicker Value="@entryDate" ValueChanged="@(d => entryDate = d)" Placeholder="1403/01/15" />
            </div>
            <div class="form-group">
                <label>تاریخ انقضا *</label>
                <PersianDatePicker Value="@expiryDate" ValueChanged="@(d => expiryDate = d)" Placeholder="1403/07/15" />
            </div>
            <div class="form-group">
                <label>توضیحات</label>
                <input @bind="notes" class="form-input" />
            </div>
        </div>
        @if (!string.IsNullOrEmpty(ok))  { <div class="alert alert-success">@ok</div> }
        @if (!string.IsNullOrEmpty(err)) { <div class="alert alert-error">@err</div> }
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="Submit">✅ ثبت ورودی</button>
            <button class="btn btn-secondary" @onclick="Reset">پاک کردن</button>
        </div>
    </div>
}
else
{
    <div class="form-card" style="border: 2px solid #f59e0b;">
        <h3 style="color:#b45309;">✏️ ویرایش ورودی انبار</h3>
        <div class="form-grid">
            <div class="form-group">
                <label>ماده اولیه</label>
                <input value="[@(editEntry!.Material?.Code)] @(editEntry!.Material?.Name)" class="form-input" disabled />
            </div>
            <div class="form-group">
                <label>مقدار *</label>
                <input @bind="eQty" type="number" step="0.01" class="form-input" />
            </div>
            <div class="form-group"><label>واحد</label><select class="form-input" @bind="eUnit" @bind:after="RecalcEditPrice">@foreach(var u in editUnits){<option value="@u.UnitName">@u.UnitName</option>}</select></div>
            @if (Auth.CanViewPrice)
            {
                <div class="form-group">
                    <label>فی خرید هر @(editEntry!.Material?.BaseUnitName ?? "واحد پایه") (ریال)</label>
                    <input @bind="eBasePrice" @bind:after="RecalcEditPrice" type="number" class="form-input" />
                </div>
                <div class="form-group">
                    <label>قیمت هر @eUnit (ریال) *</label>
                    <input @bind="ePrice" @bind:after="RecalcEditBasePrice" type="number" class="form-input" />
                </div>
            }
            <div class="form-group">
                <label>تاریخ ورود *</label>
                <PersianDatePicker Value="@eEntryDate" ValueChanged="@(d => eEntryDate = d)" Placeholder="1403/01/15" />
            </div>
            <div class="form-group">
                <label>تاریخ انقضا *</label>
                <PersianDatePicker Value="@eExpiryDate" ValueChanged="@(d => eExpiryDate = d)" Placeholder="1403/07/15" />
            </div>
            <div class="form-group">
                <label>توضیحات</label>
                <input @bind="eNotes" class="form-input" />
            </div>
        </div>
        @if (!string.IsNullOrEmpty(editErr)) { <div class="alert alert-error">@editErr</div> }
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="SaveEdit">💾 ذخیره تغییرات</button>
            <button class="btn btn-secondary" @onclick="CancelEdit">انصراف</button>
        </div>
    </div>
}

@if (entries.Any())
{
    <div style="display:flex; justify-content:space-between; align-items:center; margin: 1rem 0 0.5rem;">
        <div class="section-title" style="margin:0;">آخرین ورودی‌ها</div>
        <div style="max-width:300px;">
            <input value="@searchEntries" @oninput="OnSearchEntries" class="form-input search-input" placeholder="🔍 جستجو..." style="margin:0;" />
        </div>
    </div>
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>انبار</th><th>کد</th><th>ماده</th><th>مقدار</th>
                    @if (Auth.CanViewPrice) { <th>قیمت واحد</th> }
                    <th>تاریخ ورود</th><th>تاریخ انقضا</th><th>ثبت‌کننده</th>
                    @if (Auth.IsManager) { <th></th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var e in filteredEntries)
                {
                    <tr class="@(e.ExpiryDate < DateTime.Now ? "row-warning" : "")">
                        <td>@e.Warehouse?.Name</td>
                        <td><code>@e.Material?.Code</code></td>
                        <td>@e.Material?.Name</td>
                        <td>@e.EnteredQuantity.ToString("N3") @e.EnteredUnitName <small class="text-muted">= @e.Quantity.ToString("N3") @e.Material?.BaseUnitName</small></td>
                        @if (Auth.CanViewPrice)
                        {
                            <td style="@(e.PricePerUnit < 100000 ? "color:#dc2626;font-weight:bold;" : "")">
                                @e.PricePerUnit.ToString("N0") ﷼
                                @if (e.PricePerUnit < 100000) { <span title="قیمت کمتر از ۱۰۰٬۰۰۰ ریال؛ نیازمند تأیید یا اصلاح">⚠️</span> }
                            </td>
                        }
                        <td>@e.EntryDate.ToShamsi()</td>
                        <td class="@(e.ExpiryDate < DateTime.Now ? "expired" : e.ExpiryDate < DateTime.Now.AddDays(7) ? "expiring" : "")">
                            @e.ExpiryDate.ToShamsi()
                        </td>
                        <td>@e.CreatedByUsername</td>
                        @if (Auth.IsManager)
                        {
                            <td><button class="btn-icon" @onclick="()=>StartEdit(e)" title="ویرایش">✏️</button></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Auth.CanViewPrice)
    {
        var badCount = entries.Count(e => e.PricePerUnit < 100000 && !e.PriceConfirmed);
        if (badCount > 0)
        {
            <div class="alert alert-error" style="margin-top:0.5rem;">
                ⚠️ @badCount ورودی با قیمت ۱ ریال یا کمتر نیاز به اصلاح دارند.
            </div>
        }
    }
}

@code {
    List<Material> materials = new();
    List<Warehouse> warehouses = new(); int warehouseId;
    List<StockEntry> entries = new();
    List<StockEntry> filteredEntries = new();

    int selId = 0; decimal qty = 0, price = 0, basePrice = 0;string selectedUnit="";Material? selectedMaterial;List<MaterialUnitConversion> materialUnits=new();
    string notes = "", ok = "", err = "", materialSearch = "";
    IEnumerable<Material> FilteredMaterials => string.IsNullOrWhiteSpace(materialSearch) ? materials : materials.Where(x => x.Id == selId || x.Name.Contains(materialSearch, StringComparison.OrdinalIgnoreCase) || x.Code.Contains(materialSearch, StringComparison.OrdinalIgnoreCase));
    DateTime entryDate = DateTime.Today, expiryDate = DateTime.Today.AddMonths(6);

    bool editMode = false;
    StockEntry? editEntry;
    decimal eQty, ePrice, eBasePrice;string eUnit="";List<MaterialUnitConversion> editUnits=new();
    string eNotes = "", editErr = "";
    DateTime eEntryDate, eExpiryDate;
    string searchEntries = "";

    protected override async Task OnInitializedAsync()
    {
        materials = await Warehouse.GetMaterialsAsync();
        warehouses = await Warehouse.GetWarehousesAsync(); warehouseId = warehouses.FirstOrDefault()?.Id ?? 0;
        entries = await Warehouse.GetEntriesAsync();
        filteredEntries = entries;
    }

    async Task OnMaterialChange(ChangeEventArgs e){selId=int.TryParse(e.Value?.ToString(),out var id)?id:0;selectedMaterial=materials.FirstOrDefault(x=>x.Id==selId);materialUnits=selId>0?await Warehouse.GetMaterialUnitsAsync(selId):new();selectedUnit=materialUnits.FirstOrDefault(x=>x.IsLegacyStockUnit)?.UnitName??materialUnits.FirstOrDefault()?.UnitName??"";RecalcPrice();}

    static decimal Factor(List<MaterialUnitConversion> units,string unit)=>units.FirstOrDefault(x=>x.UnitName==unit)?.FactorToBaseUnit is decimal f&&f>0?f:1;
    void RecalcPrice(){if(basePrice>0)price=Math.Round(basePrice*Factor(materialUnits,selectedUnit),0);}
    void RecalcBasePrice()=>basePrice=Math.Round(price/Factor(materialUnits,selectedUnit),2);
    void RecalcEditPrice(){if(eBasePrice>0)ePrice=Math.Round(eBasePrice*Factor(editUnits,eUnit),0);}
    void RecalcEditBasePrice()=>eBasePrice=Math.Round(ePrice/Factor(editUnits,eUnit),2);

    void OnSearchEntries(ChangeEventArgs e)
    {
        searchEntries = e.Value?.ToString() ?? "";
        ApplyFilter();
    }

    async Task Submit()
    {
        ok = ""; err = "";
        if (selId == 0) { err = "ماده را انتخاب کنید"; return; }
        if (warehouseId == 0) { err = "انبار مقصد را انتخاب کنید"; return; }
        if (qty <= 0)   { err = "مقدار باید بیشتر از صفر باشد"; return; }
        if (Auth.CanViewPrice && price <= 0) { err = "قیمت باید بیشتر از صفر باشد"; return; }

        await Warehouse.AddStockEntryAsync(new StockEntry
        {
            MaterialId = selId, WarehouseId=warehouseId, EnteredQuantity=qty,EnteredUnitName=selectedUnit,Quantity = qty, PricePerUnit = price,
            EntryDate = entryDate, ExpiryDate = expiryDate, Notes = notes,
            CreatedByUserId = Auth.CurrentUser!.Id, CreatedByUsername = Auth.CurrentUser.Username
        });
        var m = materials.FirstOrDefault(x => x.Id == selId);
        ok = $"✅ {qty} از [{m?.Code}] {m?.Name} در تاریخ {entryDate.ToShamsi()} ثبت شد";
        materials = await Warehouse.GetMaterialsAsync();
        entries = await Warehouse.GetEntriesAsync();
        ApplyFilter();
        Reset();
    }

    void Reset()
    {
        selId = 0; qty = 0; price = 0; basePrice = 0; selectedMaterial = null; materialUnits = new(); selectedUnit = ""; materialSearch = "";
        entryDate = DateTime.Today; expiryDate = DateTime.Today.AddMonths(6); notes = "";
    }

    async Task StartEdit(StockEntry e)
    {
        editEntry   = e;
        eQty        = e.EnteredQuantity;
        eUnit       = e.EnteredUnitName;
        editUnits   = await Warehouse.GetMaterialUnitsAsync(e.MaterialId);
        ePrice      = e.PricePerUnit;
        RecalcEditBasePrice();
        eEntryDate  = e.EntryDate;
        eExpiryDate = e.ExpiryDate;
        eNotes      = e.Notes;
        editErr     = "";
        editMode    = true;
        ok          = "";
    }

    void CancelEdit() { editMode = false; editEntry = null; }

    async Task SaveEdit()
    {
        editErr = "";
        if (eQty <= 0) { editErr = "مقدار باید بیشتر از صفر باشد"; return; }
        if (Auth.CanViewPrice && ePrice <= 0) { editErr = "قیمت باید بیشتر از صفر باشد"; return; }

        editEntry!.EnteredQuantity=eQty;editEntry.EnteredUnitName=eUnit;editEntry.Quantity=eQty;
        editEntry.PricePerUnit = ePrice;
        editEntry.EntryDate    = eEntryDate;
        editEntry.ExpiryDate   = eExpiryDate;
        editEntry.Notes        = eNotes;

        await Warehouse.UpdateStockEntryAsync(editEntry);

        editMode  = false;
        editEntry = null;
        entries = await Warehouse.GetEntriesAsync();
        ApplyFilter();
        ok = "✅ ورودی با موفقیت ویرایش شد";
    }

    void ApplyFilter()
    {
        filteredEntries = string.IsNullOrWhiteSpace(searchEntries)
            ? entries
            : entries.Where(en =>
                (en.Material?.Name?.Contains(searchEntries, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (en.Material?.Code?.Contains(searchEntries, StringComparison.OrdinalIgnoreCase) ?? false))
              .ToList();
    }
}
