@using WarehouseApp.Services
@using WarehouseApp.Models
@inject WarehouseService Warehouse
@inject AuthService Auth

<div class="page-header"><h2>⬆️ ورود مواد به انبار</h2></div>

@if (!editMode)
{
    <div class="form-card">
        <div class="form-grid">
            <div class="form-group"><label>انبار مقصد *</label><select @bind="warehouseId" class="form-input"><option value="0">انتخاب کنید...</option>@foreach(var w in warehouses){<option value="@w.Id">@w.Name</option>}</select></div>
            <div class="form-group">
                <label>ماده اولیه *</label>
                <MaterialPicker Materials="materials" SelectedId="selId" SelectedIdChanged="OnMaterialChange" Detail="@(m => m.StockUnitName)" />
            </div>
            <div class="form-group">
                <label>مقدار *</label>
                <input @bind="qty" type="number" step="any" min="0" class="form-input" />
            </div>
            <div class="form-group"><label>واحد *</label><select class="form-input" @bind="selectedUnit" disabled="@(units == null)">@if(units != null){@foreach(var u in units.Choices){<option value="@u">@u</option>}}</select></div>
            @if (Auth.CanViewPrice)
            {
                <div class="form-group">
                    <label>مبلغ کل فاکتور (ریال) *</label>
                    <input @bind="total" @bind:event="oninput" type="number" min="0" class="form-input" />
                    @if (total > 0) { <small class="form-hint">@UnitSet.N(total, 0) ریال</small> }
                </div>
            }
            <div class="form-group">
                <label>تاریخ ورود *</label>
                <PersianDatePicker Value="@entryDate" ValueChanged="@(d => entryDate = d)" Placeholder="1403/01/15" />
            </div>
            <div class="form-group">
                <label>تاریخ انقضا *</label>
                <PersianDatePicker Value="@expiryDate" ValueChanged="@(d => expiryDate = d)" Placeholder="1403/07/15" />
            </div>
            <div class="form-group">
                <label>توضیحات</label>
                <input @bind="notes" class="form-input" />
            </div>
        </div>
        @if (units != null && qty > 0 && units.Has(selectedUnit))
        {
            var stockQty = units.ToStock(qty, selectedUnit);
            <div class="info-banner">
                ورود به انبار: <strong>@units.Format(stockQty)</strong>
                @if (Auth.CanViewPrice && total > 0)
                {
                    var perStock = total / stockQty;
                    <div class="unit-price-preview">
                        @foreach (var u in units.Units.Where(x => !x.IsDerived || x.Name == units.RecipeUnit || x.Name is "کیلوگرم" or "لیتر"))
                        {
                            <span class="status-badge ok">هر ۱ @u.Name: @(u.IsApproximate ? "≈ " : "")@UnitSet.N(units.PriceOf(u.Name, perStock), 0) ریال</span>
                        }
                    </div>
                }
            </div>
        }
        @if (!string.IsNullOrEmpty(ok))  { <div class="alert alert-success">@ok</div> }
        @if (!string.IsNullOrEmpty(err)) { <div class="alert alert-error">@err</div> }
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="Submit" disabled="@busy">✅ ثبت ورودی</button>
            <button class="btn btn-secondary" @onclick="Reset">پاک کردن</button>
        </div>
    </div>
}
else
{
    <div class="form-card" style="border: 2px solid #f59e0b;">
        <h3 style="color:#b45309;">✏️ ویرایش ورودی انبار</h3>
        <div class="form-grid">
            <div class="form-group">
                <label>ماده اولیه</label>
                <input value="[@(editEntry!.Material?.Code)] @(editEntry!.Material?.Name)" class="form-input" disabled />
            </div>
            <div class="form-group">
                <label>مقدار *</label>
                <input @bind="eQty" type="number" step="any" min="0" class="form-input" />
            </div>
            <div class="form-group"><label>واحد</label><select class="form-input" @bind="eUnit">@if(editUnits != null){@foreach(var u in editUnits.Choices){<option value="@u">@u</option>}}</select></div>
            @if (Auth.CanViewPrice)
            {
                <div class="form-group">
                    <label>مبلغ کل (ریال) *</label>
                    <input @bind="eTotal" @bind:event="oninput" type="number" min="0" class="form-input" />
                </div>
            }
            <div class="form-group">
                <label>تاریخ ورود *</label>
                <PersianDatePicker Value="@eEntryDate" ValueChanged="@(d => eEntryDate = d)" Placeholder="1403/01/15" />
            </div>
            <div class="form-group">
                <label>تاریخ انقضا *</label>
                <PersianDatePicker Value="@eExpiryDate" ValueChanged="@(d => eExpiryDate = d)" Placeholder="1403/07/15" />
            </div>
            <div class="form-group">
                <label>توضیحات</label>
                <input @bind="eNotes" class="form-input" />
            </div>
        </div>
        @if (editUnits != null && eQty > 0 && editUnits.Has(eUnit))
        {
            var stockQty = editUnits.ToStock(eQty, eUnit);
            <div class="info-banner">= <strong>@editUnits.Format(stockQty)</strong>@if (Auth.CanViewPrice && eTotal > 0) {<span> — هر ۱ @editUnits.StockUnit: @UnitSet.N(eTotal / stockQty, 0) ریال</span>}</div>
        }
        @if (!string.IsNullOrEmpty(editErr)) { <div class="alert alert-error">@editErr</div> }
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="SaveEdit" disabled="@busy">💾 ذخیره تغییرات</button>
            <button class="btn btn-secondary" @onclick="CancelEdit">انصراف</button>
        </div>
    </div>
}

@if (entries.Any())
{
    <div style="display:flex; justify-content:space-between; align-items:center; margin: 1rem 0 0.5rem;">
        <div class="section-title" style="margin:0;">آخرین ورودی‌ها</div>
        <div style="max-width:300px;">
            <input value="@searchEntries" @oninput="OnSearchEntries" class="form-input search-input" placeholder="🔍 جستجو..." style="margin:0;" />
        </div>
    </div>
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>انبار</th><th>کد</th><th>ماده</th><th>مقدار</th>
                    @if (Auth.CanViewPrice) { <th>فی هر واحد موجودی</th><th>مبلغ کل</th> }
                    <th>تاریخ ورود</th><th>تاریخ انقضا</th><th>ثبت‌کننده</th>
                    @if (Auth.IsManager) { <th></th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var e in filteredEntries)
                {
                    <tr class="@(e.ExpiryDate < DateTime.Now ? "row-warning" : "")">
                        <td>@e.Warehouse?.Name</td>
                        <td><code>@e.Material?.Code</code></td>
                        <td>@e.Material?.Name</td>
                        <td>@UnitSet.N(e.EnteredQuantity) @e.EnteredUnitName @if (!UnitSet.Same(e.EnteredUnitName, e.Material?.StockUnitName)) {<small class="text-muted">= @display.Format(e.Quantity, e.Material)</small>}</td>
                        @if (Auth.CanViewPrice)
                        {
                            <td style="@(e.PricePerUnit < 100000 ? "color:#dc2626;font-weight:bold;" : "")">
                                @e.PricePerUnit.ToString("N0") ﷼ <small class="text-muted">/ @e.Material?.StockUnitName</small>
                                @if (e.PricePerUnit < 100000) { <span title="قیمت کمتر از ۱۰۰٬۰۰۰ ریال؛ نیازمند تأیید یا اصلاح">⚠️</span> }
                            </td>
                            <td>@((e.TotalPrice > 0 ? e.TotalPrice : e.Quantity * e.PricePerUnit).ToString("N0")) ﷼</td>
                        }
                        <td>@e.EntryDate.ToShamsi()</td>
                        <td class="@(e.ExpiryDate < DateTime.Now ? "expired" : e.ExpiryDate < DateTime.Now.AddDays(7) ? "expiring" : "")">
                            @e.ExpiryDate.ToShamsi()
                        </td>
                        <td>@e.CreatedByUsername</td>
                        @if (Auth.IsManager)
                        {
                            <td><button class="btn-icon" @onclick="()=>StartEdit(e)" title="ویرایش">✏️</button></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Auth.CanViewPrice)
    {
        var badCount = entries.Count(e => e.PricePerUnit < 100000 && !e.PriceConfirmed);
        if (badCount > 0)
        {
            <div class="alert alert-error" style="margin-top:0.5rem;">
                ⚠️ @badCount ورودی با فی کمتر از ۱۰۰٬۰۰۰ ریال (برای هر واحد موجودی) نیاز به بررسی دارند.
            </div>
        }
    }
}

@code {
    List<Material> materials = new();
    List<Warehouse> warehouses = new(); int warehouseId;
    List<StockEntry> entries = new();
    List<StockEntry> filteredEntries = new();
    StockDisplay display = StockDisplay.Empty;

    int selId = 0; decimal qty = 0, total = 0; string selectedUnit = ""; UnitSet? units;
    string notes = "", ok = "", err = ""; bool busy;
    DateTime entryDate = DateTime.Today, expiryDate = DateTime.Today.AddMonths(6);

    bool editMode = false;
    StockEntry? editEntry;
    decimal eQty, eTotal; string eUnit = ""; UnitSet? editUnits;
    string eNotes = "", editErr = "";
    DateTime eEntryDate, eExpiryDate;
    string searchEntries = "";

    protected override async Task OnInitializedAsync()
    {
        materials = await Warehouse.GetMaterialsAsync();
        warehouses = await Warehouse.GetWarehousesAsync(); warehouseId = warehouses.FirstOrDefault()?.Id ?? 0;
        display = await Warehouse.GetStockDisplayAsync();
        entries = await Warehouse.GetEntriesAsync();
        ApplyFilter();
    }

    async Task OnMaterialChange(int id)
    {
        selId = id; units = id > 0 ? await Warehouse.GetUnitSetAsync(id) : null;
        selectedUnit = units?.StockUnit ?? "";
    }

    void OnSearchEntries(ChangeEventArgs e)
    {
        searchEntries = e.Value?.ToString() ?? "";
        ApplyFilter();
    }

    async Task Submit()
    {
        ok = ""; err = "";
        if (selId == 0) { err = "ماده را انتخاب کنید"; return; }
        if (warehouseId == 0) { err = "انبار مقصد را انتخاب کنید"; return; }
        if (qty <= 0) { err = "مقدار باید بیشتر از صفر باشد"; return; }
        if (Auth.CanViewPrice && total <= 0) { err = "مبلغ کل را وارد کنید"; return; }
        busy = true;
        try
        {
            await Warehouse.AddStockEntryAsync(new StockEntry
            {
                MaterialId = selId, WarehouseId = warehouseId, EnteredQuantity = qty, EnteredUnitName = selectedUnit, TotalPrice = Auth.CanViewPrice ? total : 0,
                EntryDate = entryDate, ExpiryDate = expiryDate, Notes = notes,
                CreatedByUserId = Auth.CurrentUser!.Id, CreatedByUsername = Auth.CurrentUser.Username
            });
            var m = materials.FirstOrDefault(x => x.Id == selId);
            ok = $"✅ {UnitSet.N(qty)} {selectedUnit} [{m?.Code}] {m?.Name} در تاریخ {entryDate.ToShamsi()} ثبت شد";
            materials = await Warehouse.GetMaterialsAsync();
            entries = await Warehouse.GetEntriesAsync();
            ApplyFilter();
            Reset(keepMessage: true);
        }
        catch (Exception ex) { err = $"❌ {ex.Message}"; }
        finally { busy = false; }
    }

    void Reset() => Reset(false);
    void Reset(bool keepMessage)
    {
        selId = 0; qty = 0; total = 0; units = null; selectedUnit = "";
        entryDate = DateTime.Today; expiryDate = DateTime.Today.AddMonths(6); notes = "";
        if (!keepMessage) { ok = ""; err = ""; }
    }

    async Task StartEdit(StockEntry e)
    {
        editEntry   = e;
        editUnits   = await Warehouse.GetUnitSetAsync(e.MaterialId);
        eQty        = e.EnteredQuantity > 0 ? e.EnteredQuantity : e.Quantity;
        eUnit       = editUnits.Has(e.EnteredUnitName) ? e.EnteredUnitName : editUnits.StockUnit;
        eTotal      = e.TotalPrice > 0 ? e.TotalPrice : Math.Round(e.Quantity * e.PricePerUnit, 0);
        eEntryDate  = e.EntryDate;
        eExpiryDate = e.ExpiryDate;
        eNotes      = e.Notes;
        editErr     = "";
        editMode    = true;
        ok          = "";
    }

    void CancelEdit() { editMode = false; editEntry = null; }

    async Task SaveEdit()
    {
        editErr = "";
        if (eQty <= 0) { editErr = "مقدار باید بیشتر از صفر باشد"; return; }
        if (Auth.CanViewPrice && eTotal <= 0) { editErr = "مبلغ کل را وارد کنید"; return; }
        busy = true;
        try
        {
            await Warehouse.UpdateStockEntryAsync(new StockEntry
            {
                Id = editEntry!.Id, EnteredQuantity = eQty, EnteredUnitName = eUnit, TotalPrice = Auth.CanViewPrice ? eTotal : editEntry.TotalPrice,
                EntryDate = eEntryDate, ExpiryDate = eExpiryDate, Notes = eNotes,
                CreatedByUserId = Auth.CurrentUser!.Id, CreatedByUsername = Auth.CurrentUser.Username
            });
            editMode = false; editEntry = null;
            entries = await Warehouse.GetEntriesAsync();
            ApplyFilter();
            ok = "✅ ورودی با موفقیت ویرایش شد";
        }
        catch (Exception ex) { editErr = $"❌ {ex.Message}"; }
        finally { busy = false; }
    }

    void ApplyFilter()
    {
        filteredEntries = entries.Where(en => TextSearch.Matches(searchEntries, en.Material?.Name, en.Material?.Code)).Take(300).ToList();
    }
}
