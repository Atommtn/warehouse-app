@using WarehouseApp.Services
@using WarehouseApp.Models
@inject WarehouseService Warehouse
@inject AuthService Auth

<div class="page-header">
    <h2>📦 مواد اولیه</h2>
    @if (Auth.IsManager) { <button class="btn btn-primary" @onclick="ShowAdd">+ ماده جدید</button> }
</div>

<div class="search-bar">
    <input value="@search" @oninput="e => search = e.Value?.ToString() ?? string.Empty" class="form-input search-input" placeholder="🔍 جستجو بر اساس نام یا کد..." />
</div>

@if (showForm && Auth.IsManager)
{
    <div class="form-card">
        <h3>@(editId.HasValue ? "ویرایش ماده" : "ماده جدید")</h3>
        <div class="form-grid">
            <div class="form-group"><label>کد ماده *</label><input @bind="fCode" class="form-input" placeholder="01000" /></div>
            <div class="form-group"><label>نام ماده *</label><input @bind="fName" class="form-input" /></div>
            <div class="form-group">
                <label>گروه کالا</label>
                <input value="@groupSearch" @oninput="OnGroupSearch" class="form-input" placeholder="🔍 جستجوی گروه کالا..." />
                <select @bind="fGroupId" class="form-input">
                    <option value="">انتخاب کنید...</option>
                    @foreach (var g in groups) { <option value="@g.Id">@g.Name</option> }
                </select>
            </div>
            @if (!editId.HasValue)
            {
            <div class="form-group">
                <label>واحد موجودی *</label>
                <select @bind="fStockUnit" class="form-input">
                    <option value="">انتخاب کنید...</option>
                    @foreach (var u in UnitNames) { <option value="@u">@u</option> }
                </select>
                <small class="form-hint">انبار با این واحد شمرده می‌شود (گونی، کارتن، سطل...)</small>
            </div>
            <div class="form-group">
                <label>واحد رسپی *</label>
                <select @bind="fRecipeUnit" class="form-input">
                    @foreach (var u in UnitNames) { <option value="@u">@u</option> }
                </select>
                <small class="form-hint">مبنای قیمت و هزینه‌ی رسپی (معمولاً کیلوگرم)</small>
            </div>
            @if (NeedsRecipeRelation)
            {
            <div class="form-group">
                <label>هر ۱ @fStockUnit چند @fRecipeUnit است؟ *</label>
                <input @bind="fRecipePerStock" type="number" step="any" min="0" class="form-input" placeholder="مثال: ۴۰" />
                <label class="permission-item"><input type="checkbox" @bind="fApproximate" /><span>تقریبی است (مثلاً وزن کارتن ثابت نیست)</span></label>
            </div>
            }
            }
            else
            {
            <div class="form-group"><label>واحدها</label><div class="form-hint">واحد موجودی: <strong>@editStockUnit</strong> — برای تغییر واحدها یا افزودن واحدهای دیگر (شانه، عدد، بسته...) به صفحه‌ی «واحدهای کالا» بروید.</div></div>
            }
            <div class="form-group"><label>حد هشدار موجودی (@(editId.HasValue ? editStockUnit : fStockUnit))</label><input @bind="fMinStock" type="number" step="any" class="form-input" /></div>
            <div class="form-group">
                <label>تأمین‌کننده</label>
                <input value="@supplierSearch" @oninput="OnSupplierSearch" class="form-input" placeholder="🔍 جستجوی تأمین‌کننده..." />
                <select @bind="fSupplierId" class="form-input">
                    <option value="">انتخاب کنید...</option>
                    @foreach (var s in suppliers) { <option value="@s.Id">@s.Name</option> }
                </select>
            </div>
            <div class="form-group"><label>توضیحات</label><input @bind="fNotes" class="form-input" /></div>
        </div>
        <div class="form-note">
            💡 قیمت هنگام ورود به انبار ثبت می‌شود.<br/>
            📐 <strong>مثال:</strong> آرد با واحد موجودی «گونی» و واحد رسپی «کیلوگرم»، هر ۱ گونی = ۴۰ کیلوگرم. در رسپی ۳۵۰ گرم وارد کنید.
        </div>
        @if (!string.IsNullOrEmpty(err)) { <div class="alert alert-error">@err</div> }
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="Save">💾 ذخیره</button>
            <button class="btn btn-secondary" @onclick="()=>showForm=false">انصراف</button>
        </div>
    </div>
}

<div class="table-responsive">
    <table class="data-table">
        <thead>
            <tr>
                <th>کد</th><th>نام</th><th>گروه</th><th>واحد موجودی</th>
                <th>واحدهای دیگر</th><th>واحد رسپی</th>
                <th>موجودی</th><th>هشدار</th><th>تأمین‌کننده</th><th>وضعیت</th>
                @if (Auth.IsManager) { <th></th> }
            </tr>
        </thead>
        <tbody>
            @foreach (var m in FilteredMaterials)
            {
                var set = display.For(m);
                <tr class="@(m.CurrentStock<=m.MinStockLevel?"row-warning":"")">
                    <td><code>@m.Code</code></td>
                    <td><strong>@m.Name</strong></td>
                    <td>@(m.Group?.Name??"-")</td>
                    <td>@m.StockUnitName</td>
                    <td>
                        @foreach (var u in set.Units.Where(u => !u.IsDerived && !UnitSet.Same(u.Name, set.StockUnit)))
                        { <span class="conversion-badge">۱ @set.StockUnit = @(u.IsApproximate ? "≈" : "")@UnitSet.N(u.PerStockUnit) @u.Name</span> }
                    </td>
                    <td>@m.RecipeUnitName</td>
                    <td>@display.Format(m.CurrentStock, m)</td>
                    <td>@UnitSet.N(m.MinStockLevel) @m.StockUnitName</td>
                    <td>@(m.Supplier?.Name??"-")</td>
                    <td>
                        @if (m.CurrentStock<=m.MinStockLevel)          { <span class="status-badge danger">خرید</span> }
                        else if (m.CurrentStock<=m.MinStockLevel*1.5m) { <span class="status-badge warning">کم</span> }
                        else                                            { <span class="status-badge ok">✓</span> }
                    </td>
                    @if (Auth.IsManager)
                    {
                        <td>
                            <button class="btn-icon" @onclick="()=>Edit(m)">✏️</button>
                            <button class="btn-icon" @onclick="()=>Delete(m.Id)">🗑️</button>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    string groupSearch="", supplierSearch="";
    List<Material> materials=new(); List<Supplier> suppliers=new();
    List<Unit> units=new(); List<MaterialGroup> groups=new();
    bool showForm; int? editId; string search=""; StockDisplay display=StockDisplay.Empty;
    string fCode="",fName="",fNotes="",fStockUnit="",fRecipeUnit="کیلوگرم",editStockUnit="",err="";
    decimal fMinStock=0, fRecipePerStock=0; bool fApproximate;
    int? fSupplierId, fGroupId;
    IEnumerable<Material> FilteredMaterials => materials.Where(m => TextSearch.Matches(search, m.Name, m.Code));
    IEnumerable<string> UnitNames => units.Select(u => u.Name).Concat(new[] { "کیلوگرم", "گرم", "لیتر", "میلی‌لیتر", "عدد" }).Distinct(StringComparer.OrdinalIgnoreCase);
    bool NeedsRecipeRelation => !string.IsNullOrWhiteSpace(fStockUnit) && !UnitSet.Same(fStockUnit, fRecipeUnit) && UnitSet.StandardFactor(fStockUnit, fRecipeUnit) == null;

    protected override async Task OnInitializedAsync()
    {
        materials = await Warehouse.GetMaterialsAsync(); display = await Warehouse.GetStockDisplayAsync();
        suppliers = await Warehouse.GetSuppliersAsync();
        units     = await Warehouse.GetUnitsAsync();
        groups    = await Warehouse.GetGroupsAsync();
    }


    async Task OnGroupSearch(ChangeEventArgs e)
    {
        groupSearch = e.Value?.ToString() ?? "";
        groups = (await Warehouse.GetGroupsAsync()).Where(g => string.IsNullOrWhiteSpace(groupSearch) || g.Name.Contains(groupSearch, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    async Task OnSupplierSearch(ChangeEventArgs e)
    {
        supplierSearch = e.Value?.ToString() ?? "";
        suppliers = (await Warehouse.GetSuppliersAsync()).Where(s => string.IsNullOrWhiteSpace(supplierSearch) || s.Name.Contains(supplierSearch, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    void ShowAdd()
    {
        editId=null; fCode=fName=fNotes=err="";
        fMinStock=0; fRecipePerStock=0; fApproximate=false; fStockUnit=""; fRecipeUnit="کیلوگرم";
        fSupplierId=fGroupId=null; showForm=true;
    }

    void Edit(Material m)
    {
        editId=m.Id; fCode=m.Code; fName=m.Name; fMinStock=m.MinStockLevel;
        fSupplierId=m.SupplierId; fGroupId=m.GroupId; editStockUnit=m.StockUnitName;
        fNotes=m.Notes;
        err=""; showForm=true;
    }

    async Task Save()
    {
        err="";
        if (string.IsNullOrWhiteSpace(fCode)) { err="کد ماده اجباری است"; return; }
        if (string.IsNullOrWhiteSpace(fName)) { err="نام ماده اجباری است"; return; }
        if (!editId.HasValue && string.IsNullOrWhiteSpace(fStockUnit)) { err="واحد موجودی اجباری است"; return; }
        if (!editId.HasValue && NeedsRecipeRelation && fRecipePerStock <= 0) { err=$"بگویید هر ۱ {fStockUnit} چند {fRecipeUnit} است"; return; }
        if (await Warehouse.CodeExistsAsync(fCode, editId)) { err=$"کد {fCode} قبلاً ثبت شده"; return; }
        try
        {
            if (editId.HasValue)
                await Warehouse.UpdateMaterialAsync(new Material { Id=editId.Value, Code=fCode.Trim(), Name=fName.Trim(), GroupId=fGroupId, MinStockLevel=fMinStock, SupplierId=fSupplierId, Notes=fNotes });
            else
                await Warehouse.AddMaterialAsync(new Material
                {
                    Code=fCode.Trim(), Name=fName.Trim(), GroupId=fGroupId,
                    MinStockLevel=fMinStock, SupplierId=fSupplierId, Notes=fNotes,
                    StockUnitName=fStockUnit, RecipeUnitName=string.IsNullOrWhiteSpace(fRecipeUnit) ? fStockUnit : fRecipeUnit
                }, fRecipePerStock, fApproximate);
        }
        catch (Exception ex) { err = ex.Message; return; }
        showForm=false; materials=await Warehouse.GetMaterialsAsync(); display=await Warehouse.GetStockDisplayAsync();
    }

    async Task Delete(int id) { await Warehouse.DeleteMaterialAsync(id); materials=await Warehouse.GetMaterialsAsync(); }
}
