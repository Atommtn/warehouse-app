@using WarehouseApp.Services
@inject AuthService Auth
@inject WarehouseService Warehouse
@inject IJSRuntime JS
@implements IDisposable

<div class="app-shell">
    <div class="mobile-header">
        <button class="hamburger" @onclick="ToggleSidebar">☰</button>
        <span class="mobile-title">🏭 انبارداری</span>
        @if (pendingCount > 0 && Auth.CanApprove)
        { <span class="mobile-badge">@pendingCount</span> }
    </div>

    @if (sidebarOpen)
    { <div class="sidebar-overlay" @onclick="ToggleSidebar"></div> }

    <nav class="sidebar @(sidebarOpen ? "open" : "")">
        <div class="sidebar-header">
            <span class="logo-icon">🏭</span>
            <div>
                <div class="app-name">انبارداری هوشمند</div>
                <div class="user-badge role-@Auth.CurrentUser?.Role.ToString().ToLower()">
                    @RoleLabel(Auth.CurrentUser?.Role) — @Auth.CurrentUser?.FullName
                </div>
            </div>
        </div>

        <ul class="nav-menu">
            @if(Auth.CanAccess("dashboard")){<li class="@A("dashboard")"><button @onclick='()=>Go("dashboard")'>📊 داشبورد</button></li>}
            @if(Auth.CanAccess("materials")){<li class="@A("materials")"><button @onclick='()=>Go("materials")'>📦 مواد اولیه</button></li>}
            @if(Auth.CanAccess("archive")){<li class="@A("archive")"><button @onclick='()=>Go("archive")'>🗄️ آرشیو مواد اولیه</button></li>}
            @if(Auth.CanAccess("warehouses")){<li class="@A("warehouses")"><button @onclick='()=>Go("warehouses")'>🏬 انبارها و تفصیل</button></li>}
            @if(Auth.CanAccess("unit-config")){<li class="@A("unit-config")"><button @onclick='()=>Go("unit-config")'>⚖️ واحدهای کالا</button></li>}
            @if(Auth.CanAccess("definitions")){
            <li class="nav-parent @(IsDefinitions()?"active":"")">
                <button @onclick="ToggleDefs" class="nav-parent-btn">
                    ⚙️ تعاریف اولیه
                    <span class="nav-arrow">@(defsOpen?"▲":"▼")</span>
                </button>
                @if (defsOpen)
                {
                    <ul class="nav-submenu">
                        <li class="@AS("units")">    <button @onclick='()=>GoTab("units")'>📐 تعریف واحد</button></li>
                        <li class="@AS("suppliers")"><button @onclick='()=>GoTab("suppliers")'>🏢 تعریف تأمین‌کنندگان</button></li>
                        <li class="@AS("groups")">   <button @onclick='()=>GoTab("groups")'>📁 تعریف گروه کالایی</button></li>
                    </ul>
                }
            </li>
            }
            @if(Auth.CanAccess("entry")){<li class="@A("entry")"><button @onclick='()=>Go("entry")'>⬆️ ورود به انبار</button></li>}
            @if(Auth.CanAccess("withdrawal")){
                <li class="@A("withdrawal")">
                    <button @onclick='()=>Go("withdrawal")'>
                        ⬇️ خروج از انبار
                        @if (pendingCount > 0 && Auth.CanApprove) { <span class="badge">@pendingCount</span> }
                    </button>
                </li>
            }
            @if(Auth.CanAccess("transfer")){<li class="@A("transfer")"><button @onclick='()=>Go("transfer")'>🔄 انتقال بین انبارها</button></li>}
            @if(Auth.CanAccess("warehouse-stock")){<li class="@A("warehouse-stock")"><button @onclick='()=>Go("warehouse-stock")'>📦 موجودی تفکیکی</button></li>}
            @if(Auth.CanAccess("cardex")){<li class="@A("cardex")"><button @onclick='()=>Go("cardex")'>📒 کاردکس کالا</button></li>}
            @if(Auth.CanAccess("history")){<li class="@A("history")"><button @onclick='()=>Go("history")'>📋 تاریخچه</button></li>}
            @if(Auth.CanAccess("prices")){<li class="@A("prices")"><button @onclick='()=>Go("prices")'>📈 تحلیل قیمت</button></li>}
            @if(Auth.CanAccess("recipes")){<li class="@A("recipes")"><button @onclick='()=>Go("recipes")'>🧁 رسپی‌ها</button></li>}
            @if(Auth.CanAccess("alerts")){<li class="@A("alerts")">
                <button @onclick='()=>Go("alerts")'>
                    🔔 هشدارها
                    @if (alertCount > 0) { <span class="badge">@alertCount</span> }
                </button>
            </li>}
            @if(Auth.CanAccess("assets")){<li class="@A("assets")"><button @onclick='()=>Go("assets")'>🪑 اموال و اثاثیه</button></li>}
            @if (Auth.IsAdmin)
            {
                <li class="nav-divider"></li>
                <li class="@A("users")"><button @onclick='()=>Go("users")'>👥 مدیریت کاربران</button></li>
            }
        </ul>

        <div class="sidebar-footer">
            <button class="btn-logout" @onclick="Auth.Logout">خروج 🚪</button>
        </div>
    </nav>

    <main class="main-content" @onclick="CloseSidebar">
        @* Up to MaxTabs pages stay mounted; hidden tabs keep their searches and half-filled forms. *@
        <div class="page-tabs">
            @foreach (var t in tabs)
            {
                var key = t.Key;
                <div class="page-tab @(key == page ? "active" : "")" @key="key" @onclick="() => Go(key)" title="@Title(key)">
                    <span class="page-tab-title">@Title(key)</span>
                    @if (key == page) { <button class="page-tab-btn" title="بارگذاری مجدد" @onclick="() => Reload(key)" @onclick:stopPropagation>⟳</button> }
                    @if (tabs.Count > 1) { <button class="page-tab-btn" title="بستن" @onclick="() => CloseTab(key)" @onclick:stopPropagation>×</button> }
                </div>
            }
        </div>
        @foreach (var t in tabs)
        {
            <div class="page-pane" style="@(t.Key == page ? "" : "display:none")" @key="(t.Key, t.Version)">
                @RenderPage(t.Key)
            </div>
        }
    </main>
</div>

@code {
    const int MaxTabs = 5;
    class Tab { public string Key = ""; public int Version; }
    readonly List<Tab> tabs = new();
    readonly List<string> recent = new(); // most recently used last; the oldest is closed when a 6th tab opens
    string page = "dashboard";
    string defsTab = "units";
    int alertCount, pendingCount;
    bool sidebarOpen, defsOpen;

    protected override async Task OnInitializedAsync(){if(!Auth.CanAccess(page))page=PageAccess.Pages.FirstOrDefault(x=>Auth.CanAccess(x.Key)).Key??"dashboard";Open(page);await LoadCounts();}

    async Task LoadCounts()
    {
        var stats = await Warehouse.GetDashboardStatsAsync();
        alertCount   = stats.alertCount;
        pendingCount = stats.pendingCount;
    }

    void Go(string p)
    {
        if (p != page) _ = PushHistory(p);
        Open(p); page = p; sidebarOpen = false;
    }

    // The browser Back button walks back through the pages opened here instead of leaving the app (see appNav in app.js).
    DotNetObjectReference<MainLayout>? navRef;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        navRef = DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("appNav.init", navRef, page); } catch (JSException) { }
    }
    async Task PushHistory(string p) { try { await JS.InvokeVoidAsync("appNav.push", p); } catch (Exception) { } }
    [JSInvokable] public void OnBrowserBack(string p)
    {
        if (string.IsNullOrEmpty(p) || (p != "users" && !Auth.CanAccess(p)) || (p == "users" && !Auth.IsAdmin)) return;
        Open(p); page = p; sidebarOpen = false; StateHasChanged();
    }
    public void Dispose() => navRef?.Dispose();
    void GoTab(string tab) { Go("definitions"); defsTab = tab; }

    void Open(string p)
    {
        recent.Remove(p); recent.Add(p);
        if (tabs.Any(t => t.Key == p)) return;
        if (tabs.Count >= MaxTabs)
        {
            var oldest = recent.First(k => k != p && tabs.Any(t => t.Key == k));
            tabs.RemoveAll(t => t.Key == oldest); recent.Remove(oldest);
        }
        tabs.Add(new Tab { Key = p });
    }

    void CloseTab(string p)
    {
        if (tabs.Count <= 1) return;
        var i = tabs.FindIndex(t => t.Key == p);
        tabs.RemoveAt(i); recent.Remove(p);
        if (page == p) page = recent.LastOrDefault() ?? tabs[Math.Min(i, tabs.Count - 1)].Key;
    }

    void Reload(string p) { var t = tabs.FirstOrDefault(x => x.Key == p); if (t != null) t.Version++; }

    string Title(string p) => p == "definitions" ? "تعاریف اولیه" : PageAccess.Pages.FirstOrDefault(x => x.Key == p).Label ?? p;

    RenderFragment RenderPage(string p) => p switch
    {
        _ when p != "users" && !Auth.CanAccess(p) => _ => { },
        "dashboard"       => @<DashboardPage />,
        "materials"       => @<MaterialsPage />,
        "archive"         => @<ArchivePage />,
        "warehouses"      => @<WarehousesPage />,
        "unit-config"     => @<UnitConfigurationPage />,
        "definitions"     => @<DefinitionsPage DefaultTab="@defsTab" />,
        "entry"           => @<StockEntryPage />,
        "withdrawal"      => @<WithdrawalPage />,
        "transfer"        => @<TransferPage />,
        "warehouse-stock" => @<WarehouseInventoryPage />,
        "cardex"          => @<CardexPage />,
        "history"         => @<HistoryPage />,
        "prices"          => @<PriceAnalysisPage />,
        "recipes"         => @<RecipePage />,
        "alerts"          => @<AlertsPage />,
        "assets"          => @<AssetsPage />,
        "users" when Auth.IsAdmin => @<UsersPage />,
        _ => _ => { }
    };
    void ToggleDefs() => defsOpen = !defsOpen;
    bool IsDefinitions() => page == "definitions";
    string A(string p) => page == p ? "active" : "";
    string AS(string tab) => page == "definitions" && defsTab == tab ? "active" : "";
    void ToggleSidebar() => sidebarOpen = !sidebarOpen;
    void CloseSidebar()  { if (sidebarOpen) sidebarOpen = false; }

    string RoleLabel(UserRole? r) => r switch
    {
        UserRole.Admin     => "مدیر ارشد",
        UserRole.Manager   => "مدیر انبار",
        UserRole.Operator  => "اپراتور",
        UserRole.Attendant => "متصدی",
        UserRole.Viewer    => "بازبین",
        _ => ""
    };
}
