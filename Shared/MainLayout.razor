@using WarehouseApp.Services
@inject AuthService Auth
@inject WarehouseService Warehouse

<div class="app-shell">
    <div class="mobile-header">
        <button class="hamburger" @onclick="ToggleSidebar">☰</button>
        <span class="mobile-title">🏭 انبارداری</span>
        @if (pendingCount > 0 && Auth.CanApprove)
        { <span class="mobile-badge">@pendingCount</span> }
    </div>

    @if (sidebarOpen)
    { <div class="sidebar-overlay" @onclick="ToggleSidebar"></div> }

    <nav class="sidebar @(sidebarOpen ? "open" : "")">
        <div class="sidebar-header">
            <span class="logo-icon">🏭</span>
            <div>
                <div class="app-name">انبارداری هوشمند</div>
                <div class="user-badge role-@Auth.CurrentUser?.Role.ToString().ToLower()">
                    @RoleLabel(Auth.CurrentUser?.Role) — @Auth.CurrentUser?.FullName
                </div>
            </div>
        </div>

        <ul class="nav-menu">
            @if(Auth.CanAccess("dashboard")){<li class="@A("dashboard")"><button @onclick='()=>Go("dashboard")'>📊 داشبورد</button></li>}
            @if(Auth.CanAccess("materials")){<li class="@A("materials")"><button @onclick='()=>Go("materials")'>📦 مواد اولیه</button></li>}
            @if(Auth.CanAccess("archive")){<li class="@A("archive")"><button @onclick='()=>Go("archive")'>🗄️ آرشیو مواد اولیه</button></li>}
            @if(Auth.CanAccess("warehouses")){<li class="@A("warehouses")"><button @onclick='()=>Go("warehouses")'>🏬 انبارها و تفصیل</button></li>}
            @if(Auth.CanAccess("unit-config")){<li class="@A("unit-config")"><button @onclick='()=>Go("unit-config")'>⚖️ بازتعریف واحدها</button></li>}
            @if(Auth.CanAccess("definitions")){
            <li class="nav-parent @(IsDefinitions()?"active":"")">
                <button @onclick="ToggleDefs" class="nav-parent-btn">
                    ⚙️ تعاریف اولیه
                    <span class="nav-arrow">@(defsOpen?"▲":"▼")</span>
                </button>
                @if (defsOpen)
                {
                    <ul class="nav-submenu">
                        <li class="@AS("units")">    <button @onclick='()=>GoTab("units")'>📐 تعریف واحد</button></li>
                        <li class="@AS("suppliers")"><button @onclick='()=>GoTab("suppliers")'>🏢 تعریف تأمین‌کنندگان</button></li>
                        <li class="@AS("groups")">   <button @onclick='()=>GoTab("groups")'>📁 تعریف گروه کالایی</button></li>
                    </ul>
                }
            </li>
            }
            @if(Auth.CanAccess("entry")){<li class="@A("entry")"><button @onclick='()=>Go("entry")'>⬆️ ورود به انبار</button></li>}
            @if(Auth.CanAccess("withdrawal")){
                <li class="@A("withdrawal")">
                    <button @onclick='()=>Go("withdrawal")'>
                        ⬇️ خروج از انبار
                        @if (pendingCount > 0 && Auth.CanApprove) { <span class="badge">@pendingCount</span> }
                    </button>
                </li>
            }
            @if(Auth.CanAccess("transfer")){<li class="@A("transfer")"><button @onclick='()=>Go("transfer")'>🔄 انتقال بین انبارها</button></li>}
            @if(Auth.CanAccess("warehouse-stock")){<li class="@A("warehouse-stock")"><button @onclick='()=>Go("warehouse-stock")'>📦 موجودی تفکیکی</button></li>}
            @if(Auth.CanAccess("cardex")){<li class="@A("cardex")"><button @onclick='()=>Go("cardex")'>📒 کاردکس کالا</button></li>}
            @if(Auth.CanAccess("history")){<li class="@A("history")"><button @onclick='()=>Go("history")'>📋 تاریخچه</button></li>}
            @if(Auth.CanAccess("prices")){<li class="@A("prices")"><button @onclick='()=>Go("prices")'>📈 تحلیل قیمت</button></li>}
            @if(Auth.CanAccess("recipes")){<li class="@A("recipes")"><button @onclick='()=>Go("recipes")'>🧁 رسپی‌ها</button></li>}
            @if(Auth.CanAccess("alerts")){<li class="@A("alerts")">
                <button @onclick='()=>Go("alerts")'>
                    🔔 هشدارها
                    @if (alertCount > 0) { <span class="badge">@alertCount</span> }
                </button>
            </li>}
            @if (Auth.IsAdmin)
            {
                <li class="nav-divider"></li>
                <li class="@A("users")"><button @onclick='()=>Go("users")'>👥 مدیریت کاربران</button></li>
            }
        </ul>

        <div class="sidebar-footer">
            <button class="btn-logout" @onclick="Auth.Logout">خروج 🚪</button>
        </div>
    </nav>

    <main class="main-content" @onclick="CloseSidebar">
        @if      (page == "dashboard" && Auth.CanAccess(page))       { <DashboardPage /> }
        else if  (page == "materials" && Auth.CanAccess(page))       { <MaterialsPage /> }
        else if  (page == "archive" && Auth.CanAccess(page))         { <ArchivePage /> }
        else if  (page == "warehouses" && Auth.CanAccess(page))      { <WarehousesPage /> }
        else if  (page == "unit-config" && Auth.CanAccess(page))      { <UnitConfigurationPage /> }
        else if  (page == "definitions" && Auth.CanAccess(page))     { <DefinitionsPage DefaultTab="@defsTab" /> }
        else if  (page == "entry" && Auth.CanAccess(page))           { <StockEntryPage /> }
        else if  (page == "withdrawal" && Auth.CanAccess(page))      { <WithdrawalPage /> }
        else if  (page == "transfer" && Auth.CanAccess(page))        { <TransferPage /> }
        else if  (page == "warehouse-stock" && Auth.CanAccess(page)) { <WarehouseInventoryPage /> }
        else if  (page == "cardex" && Auth.CanAccess(page))          { <CardexPage /> }
        else if  (page == "history" && Auth.CanAccess(page))         { <HistoryPage /> }
        else if  (page == "prices" && Auth.CanAccess(page))          { <PriceAnalysisPage /> }
        else if  (page == "recipes" && Auth.CanAccess(page))         { <RecipePage /> }
        else if  (page == "alerts" && Auth.CanAccess(page))          { <AlertsPage /> }
        else if  (page == "users"      && Auth.IsAdmin)      { <UsersPage /> }
    </main>
</div>

@code {
    string page = "dashboard";
    string defsTab = "units";
    int alertCount, pendingCount;
    bool sidebarOpen, defsOpen;

    protected override async Task OnInitializedAsync(){if(!Auth.CanAccess(page))page=PageAccess.Pages.FirstOrDefault(x=>Auth.CanAccess(x.Key)).Key??"dashboard";await LoadCounts();}

    async Task LoadCounts()
    {
        var stats = await Warehouse.GetDashboardStatsAsync();
        alertCount   = stats.alertCount;
        pendingCount = stats.pendingCount;
    }

    void Go(string p) { page = p; sidebarOpen = false; }
    void GoTab(string tab) { page = "definitions"; defsTab = tab; sidebarOpen = false; }
    void ToggleDefs() => defsOpen = !defsOpen;
    bool IsDefinitions() => page == "definitions";
    string A(string p) => page == p ? "active" : "";
    string AS(string tab) => page == "definitions" && defsTab == tab ? "active" : "";
    void ToggleSidebar() => sidebarOpen = !sidebarOpen;
    void CloseSidebar()  { if (sidebarOpen) sidebarOpen = false; }

    string RoleLabel(UserRole? r) => r switch
    {
        UserRole.Admin     => "مدیر ارشد",
        UserRole.Manager   => "مدیر انبار",
        UserRole.Operator  => "اپراتور",
        UserRole.Attendant => "متصدی",
        UserRole.Viewer    => "بازبین",
        _ => ""
    };
}
