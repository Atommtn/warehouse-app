@using WarehouseApp.Models
@using WarehouseApp.Services
@inject WarehouseService WarehouseService
@inject AuthService Auth

<div class="page-header"><h2>🔄 انتقال بین انبارها</h2></div>
<div class="form-card">
    <div class="form-grid">
        <div class="form-group"><label>انبار مبدأ *</label><select class="form-input" value="@sourceId" @onchange="SourceChanged"><option value="0">انتخاب کنید...</option>@foreach(var w in warehouses){<option value="@w.Id">@w.Name</option>}</select></div>
        <div class="form-group"><label>انبار مقصد *</label><select class="form-input" @bind="destinationId"><option value="0">انتخاب کنید...</option>@foreach(var w in warehouses.Where(x=>x.Id!=sourceId)){<option value="@w.Id">@w.Name</option>}</select></div>
        <div class="form-group"><label>کالا * <small class="text-muted">(موجود در انبار مبدأ)</small></label><MaterialPicker Materials="AvailableMaterials" SelectedId="materialId" SelectedIdChanged="MaterialChanged" Detail="@(m => display.Format(StockOf(m.Id), m))" Disabled="@(sourceId == 0)" /></div>
        <div class="form-group"><label>واحد انتقال *</label><select class="form-input" value="@unitName" @onchange="UnitChanged" disabled="@(units == null)">@if(units != null){@foreach(var u in units.Choices){<option value="@u">@u</option>}}</select></div>
        <div class="form-group"><label>مقدار انتقال *</label><div class="quantity-with-action"><input class="form-input" type="number" step="any" min="0" @bind="quantity" /><button type="button" class="btn btn-secondary btn-sm" @onclick="UseAll" disabled="@(units == null)">انتقال همه</button></div>@if(units != null){<small class="form-hint">موجودی قابل انتقال: <strong>@units.Format(available)</strong></small>}</div>
        <div class="form-group"><label>تاریخ انتقال</label><PersianDatePicker Value="date" ValueChanged="@(x=>date=x)" /></div>
        <div class="form-group"><label>توضیحات</label><input class="form-input" @bind="notes" /></div>
    </div>
    @if(!string.IsNullOrEmpty(message)){<div class="alert @(success?"alert-success":"alert-error")">@message</div>}
    <button class="btn btn-primary" @onclick="Submit" disabled="@busy">ثبت انتقال</button>
</div>

@code {
    List<Warehouse> warehouses=new(); List<WarehouseStock> stocks=new(); UnitSet? units; StockDisplay display=StockDisplay.Empty;
    int sourceId,destinationId,materialId; decimal quantity,available; DateTime date=DateTime.Today;
    string notes="",message="",unitName=""; bool success,busy;
    IEnumerable<Material> AvailableMaterials=>stocks.Where(x=>x.Quantity>0&&x.Material!=null).Select(x=>x.Material!);
    decimal StockOf(int id)=>stocks.FirstOrDefault(x=>x.MaterialId==id)?.Quantity??0;

    protected override async Task OnInitializedAsync(){warehouses=await WarehouseService.GetWarehousesAsync();display=await WarehouseService.GetStockDisplayAsync();}
    async Task SourceChanged(ChangeEventArgs e){sourceId=int.TryParse(e.Value?.ToString(),out var id)?id:0;if(destinationId==sourceId)destinationId=0;await LoadStocks();if(StockOf(materialId)<=0)await MaterialChanged(0);else{available=StockOf(materialId);UseAll();}}
    async Task LoadStocks(){stocks=sourceId>0?await WarehouseService.GetWarehouseStocksAsync(sourceId):new();}
    async Task MaterialChanged(int id){materialId=id;units=id>0?await WarehouseService.GetUnitSetAsync(id):null;unitName=units?.StockUnit??"";available=StockOf(id);UseAll();}
    void UnitChanged(ChangeEventArgs e){unitName=e.Value?.ToString()??"";UseAll();}
    void UseAll(){quantity=units==null||!units.Has(unitName)?0:UnitSet.Same(unitName,units.StockUnit)?available:Math.Round(units.FromStock(available,unitName),6);}
    async Task Submit()
    {
        busy=true;
        try
        {
            if(sourceId==0||destinationId==0||materialId==0)throw new Exception("انبار مبدأ، مقصد و کالا را انتخاب کنید");
            if(quantity<=0)throw new Exception("مقدار انتقال باید بیشتر از صفر باشد");
            await WarehouseService.TransferAsync(sourceId,destinationId,materialId,quantity,unitName,date,notes,Auth.CurrentUser!.Id,Auth.CurrentUser.Username);
            success=true;message="انتقال با موفقیت ثبت و در کاردکس درج شد";notes="";
            await LoadStocks();available=StockOf(materialId);if(available<=0)await MaterialChanged(0);else UseAll();
        }
        catch(Exception ex){success=false;message=ex.Message;}
        finally{busy=false;}
    }
}
