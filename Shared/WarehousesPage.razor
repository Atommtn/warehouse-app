@using WarehouseApp.Models
@using WarehouseApp.Services
@inject WarehouseService Service
<div class="page-header"><h2>🏬 تعریف و تفصیل انبارها</h2></div>
<div class="table-responsive"><table class="data-table"><thead><tr><th>کد</th><th>نام</th><th>محل</th><th>مسئول</th><th>کد تفصیلی حسابداری</th><th>توضیحات</th><th></th></tr></thead><tbody>
@foreach(var w in items){<tr><td><input class="form-input" @bind="w.Code" /></td><td><input class="form-input" @bind="w.Name" /></td><td><input class="form-input" @bind="w.Location" /></td><td><input class="form-input" @bind="w.ResponsiblePerson" /></td><td><input class="form-input" @bind="w.AccountingDetailCode" placeholder="بعداً مطابق سیستم حسابداری" /></td><td><input class="form-input" @bind="w.Notes" /></td><td><button class="btn btn-primary btn-sm" @onclick="()=>Save(w)">ذخیره</button></td></tr>}
</tbody></table></div>@if(!string.IsNullOrEmpty(message)){<div class="alert alert-success" style="margin-top:1rem">@message</div>}
@code{List<Warehouse> items=new();string message="";protected override async Task OnInitializedAsync()=>items=await Service.GetWarehousesAsync();async Task Save(Warehouse w){await Service.UpdateWarehouseAsync(w);message=$"اطلاعات {w.Name} ذخیره شد";}}
