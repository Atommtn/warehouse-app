@using WarehouseApp.Models
@using WarehouseApp.Services
@inject WarehouseService Service
@inject IJSRuntime JS
<div class="page-header"><h2>🏬 تعریف و تفصیل انبارها</h2></div>
<div class="table-responsive"><table class="data-table"><thead><tr><th>کد</th><th>نام</th><th>محل</th><th>مسئول</th><th>کد تفصیلی حسابداری</th><th>توضیحات</th><th></th></tr></thead><tbody>
@foreach(var w in items){<tr><td><input class="form-input" @bind="w.Code" /></td><td><input class="form-input" @bind="w.Name" /></td><td><input class="form-input" @bind="w.Location" /></td><td><input class="form-input" @bind="w.ResponsiblePerson" /></td><td><input class="form-input" @bind="w.AccountingDetailCode" placeholder="بعداً مطابق سیستم حسابداری" /></td><td><input class="form-input" @bind="w.Notes" /></td><td><div class="table-actions"><button class="btn btn-primary btn-sm" @onclick="()=>Save(w)">ذخیره</button><button class="btn btn-danger btn-sm" @onclick="()=>Delete(w)">حذف</button></div></td></tr>}
</tbody></table></div>@if(!string.IsNullOrEmpty(message)){<div class="alert @(success?"alert-success":"alert-error")" style="margin-top:1rem">@message</div>}
@code{List<Warehouse> items=new();string message="";bool success;protected override async Task OnInitializedAsync()=>items=await Service.GetWarehousesAsync();async Task Save(Warehouse w){try{await Service.UpdateWarehouseAsync(w);success=true;message=$"اطلاعات {w.Name} ذخیره شد";}catch(Exception ex){success=false;message=ex.Message;}}async Task Delete(Warehouse w){if(!await JS.InvokeAsync<bool>("confirm",$"انبار «{w.Name}» حذف شود؟"))return;try{await Service.DeleteWarehouseAsync(w.Id);items=await Service.GetWarehousesAsync();success=true;message=$"انبار {w.Name} حذف شد";}catch(Exception ex){success=false;message=ex.Message;}}}
