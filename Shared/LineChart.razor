@* One series over time with a light area wash; the crosshair snaps to the nearest period. *@
<div class="chart" @onmouseleave="() => hover = -1">
    <div class="chart-plot">
        <svg viewBox="0 0 @W @H" preserveAspectRatio="xMidYMid meet" role="img" aria-label="@AriaLabel">
            @foreach (var t in ticks)
            {
                var y = Y(t);
                <line x1="@L" x2="@(W - R)" y1="@ChartMath.F(y)" y2="@ChartMath.F(y)" class="grid" />
                <g><text x="@(L - 8)" y="@ChartMath.F(y + 4)" class="tick" text-anchor="end">@Format(t)</text></g>
            }
            @if (n > 0)
            {
                <path d="@AreaPath" fill="@Color" fill-opacity="0.1" />
                <path d="@LinePath" fill="none" stroke="@Color" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
                <circle cx="@ChartMath.F(X(n - 1))" cy="@ChartMath.F(Y(Values[n - 1]))" r="5" fill="@Color" stroke="var(--chart-surface)" stroke-width="2" />
                <g><text x="@ChartMath.F(X(n - 1) - 8)" y="@ChartMath.F(Y(Values[n - 1]) - 10)" class="end-label" text-anchor="end">@Format(Values[n - 1])</text></g>
            }
            @for (var i = 0; i < n; i++)
            {
                var index = i;
                @if (i % labelEvery == 0 || i == n - 1) { <g><text x="@ChartMath.F(X(i))" y="@(H - 8)" class="tick" text-anchor="middle">@Labels[i]</text></g> }
                <rect x="@ChartMath.F(X(i) - step / 2)" y="@T" width="@ChartMath.F(Math.Max(step, 1))" height="@PlotH" fill="transparent" @onmouseover="() => hover = index" />
            }
            @if (hover >= 0 && hover < n)
            {
                <line x1="@ChartMath.F(X(hover))" x2="@ChartMath.F(X(hover))" y1="@T" y2="@(T + PlotH)" class="crosshair" />
                <circle cx="@ChartMath.F(X(hover))" cy="@ChartMath.F(Y(Values[hover]))" r="5" fill="@Color" stroke="var(--chart-surface)" stroke-width="2" />
            }
            <line x1="@L" x2="@(W - R)" y1="@(T + PlotH)" y2="@(T + PlotH)" class="axis" />
        </svg>
        @if (hover >= 0 && hover < n)
        {
            <div class="chart-tip" style="left:@ChartMath.F(Math.Clamp(X(hover) / W * 100, 12, 88))%">
                <div class="tip-title">@((Tooltips ?? Labels)[hover])</div>
                <div class="tip-row"><i class="key-line" style="background:@Color"></i><strong>@Format(Values[hover])</strong><span>@Name</span></div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<string> Labels { get; set; } = Array.Empty<string>();
    [Parameter] public IReadOnlyList<string>? Tooltips { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<decimal> Values { get; set; } = Array.Empty<decimal>();
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Color { get; set; } = "var(--series-1)";
    [Parameter] public Func<decimal, string> Format { get; set; } = ChartMath.Compact;
    [Parameter] public string AriaLabel { get; set; } = "";

    const int W = 960, H = 260, L = 92, R = 24, T = 24, PlotH = H - T - 34;
    int hover = -1, n, labelEvery = 1; double step; decimal max; List<decimal> ticks = new();
    double X(int i) => n <= 1 ? L + (W - L - R) / 2.0 : L + step * i;
    double Y(decimal v) => T + PlotH - (double)(v / max) * PlotH;
    string LinePath => string.Concat(Enumerable.Range(0, n).Select(i => $"{(i == 0 ? "M" : "L")}{ChartMath.F(X(i))},{ChartMath.F(Y(Values[i]))}"));
    string AreaPath => $"{LinePath}L{ChartMath.F(X(n - 1))},{T + PlotH}L{ChartMath.F(X(0))},{T + PlotH}Z";

    protected override void OnParametersSet()
    {
        n = Math.Min(Labels.Count, Values.Count); step = n <= 1 ? 0 : (W - L - R) / (double)(n - 1);
        (max, ticks) = ChartMath.Ticks(Values.DefaultIfEmpty(0).Max());
        labelEvery = Math.Max(1, (int)Math.Ceiling(n / 12.0));
        if (hover >= n) hover = -1;
    }
}
